    <maint:sourceJSON>{"bbox": [268.71429443359375, 523.3394165039062, 547.9678344726562, 556.6939086914062], "clean_end": 145, "clean_start": 114, "document_id": "DOC_bc4bdf2b43eb7832b16dfab1668af3e742a93a1cb1dbfd36ba2b901d5af6a371", "document_name": "13-common-causes.pdf", "original_end": 148, "original_quote": "leading to  \ninsulation breakdown", "original_start": 115, "page": 2, "paragraph_id": "P2_B6", "quote": "leading to insulation breakdown", "section": "2 Voltage imbalance", "section_id": "fault-02", "source_paragraph_cleaned": "Impact: Imbalance creates excessive current flow in one or more phases that then increases operating temperatures–leading to insulation breakdown", "source_paragraph_original": "Impact: Imbalance creates excessive current flow in one or more \nphases that then increases operating temperatures–leading to  \ninsulation breakdown\n"}</maint:sourceJSON>
