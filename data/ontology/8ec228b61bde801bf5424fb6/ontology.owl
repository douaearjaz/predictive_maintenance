  <rdf:Description rdf:about="https://example.org/maintenance/evidence/68509b8634576631f4bf1797/0">
    <rdf:type rdf:resource="https://example.org/maintenance/Evidence"/>
    <maint:sourceJSON>{"bbox": [41.99760055541992, 601.0715942382812, 293.1300964355469, 690.818115234375], "clean_end": 109, "clean_start": 80, "document_id": "DOC_eae8090d19d0478c75eda61af9c97af5953dc4395b339ef3c9806d9fa405e1ad", "document_name": "Manual_Udrzba_Montaz_TIMKEN_AJ.pdf", "original_end": 109, "original_quote": "improper storage and handling", "original_start": 80, "page": 12, "paragraph_id": "P12_B24", "quote": "improper storage and handling", "section": "Damaged bearings", "section_id": "timken-damage", "source_paragraph_cleaned": "Despite taking proper precautions, bearings may become dam- aged either through improper storage and handling or through normal wear in use. Bearings that have been damaged or are no longer within specifications may still be returned to service after repair or refurbishment. Some bearings can be refurbished more than once. Eventually all bearings will sustain sufficient wear or damage and will have to be replaced.", "source_paragraph_original": "Despite taking proper precautions, bearings may become dam-\naged either through improper storage and handling or through \nnormal wear in use. Bearings that have been damaged or are no \nlonger within specifications may still be returned to service after \nrepair or refurbishment. Some bearings can be refurbished more \nthan once. Eventually all bearings will sustain sufficient wear or \ndamage and will have to be replaced.\n"}</maint:sourceJSON>
    <maint:quote>improper storage and handling</maint:quote>
    <maint:page rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</maint:page>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/maintenance/evidence/ef31f4e6fb0e61b459a294a9/0">
