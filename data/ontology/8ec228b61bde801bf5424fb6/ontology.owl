    <maint:sourceJSON>{"bbox": [63.25, 198.52781677246094, 225.35206604003906, 218.3039093017578], "clean_end": 48, "clean_start": 0, "document_id": "DOC_775874115de53f4ac9dfe96ef9fac58f3b2a9a0ae5697e5bff5c94110edaa6ec", "document_name": "Electric Motor Troubleshooting (Polyphase).pdf", "original_end": 48, "original_quote": "Cause 2a: The motor controller will not\noperate.", "original_start": 0, "page": 6, "paragraph_id": "P6_B24", "quote": "Cause 2a: The motor controller will not operate.", "section": "Starting: motor controller", "section_id": "lincoln-controller", "source_paragraph_cleaned": "Cause 2a: The motor controller will not operate.", "source_paragraph_original": "Cause 2a: The motor controller will not\noperate.\n"}</maint:sourceJSON>
