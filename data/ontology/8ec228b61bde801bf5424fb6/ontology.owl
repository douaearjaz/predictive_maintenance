    <maint:sourceJSON>{"bbox": [62.63999557495117, 426.9633483886719, 510.0133361816406, 463.6756591796875], "clean_end": 101, "clean_start": 20, "document_id": "DOC_cf0bdf9d28720ead73ea3680ce4f0d19dc8ff2f84bcf454378dea1215b51fa22", "document_name": "NP_7502_Electric Motor Predictive and Preventive Maintenance Guide.pdf", "original_end": 101, "original_quote": "Excessive moisture causes failures in motor winding insulation and\nin motor leads", "original_start": 20, "page": 54, "paragraph_id": "P54_B6", "quote": "Excessive moisture causes failures in motor winding insulation and in motor leads", "section": "Moisture and motor insulation", "section_id": "epri-moisture", "source_paragraph_cleaned": "Excessive Moisture. Excessive moisture causes failures in motor winding insulation and in motor leads. It can also cause loss of lubrication capability in bearing oil systems and deterioration of motor parts, both electrical and mechanical.", "source_paragraph_original": "Excessive Moisture. Excessive moisture causes failures in motor winding insulation and\nin motor leads. It can also cause loss of lubrication capability in bearing oil systems and\ndeterioration of motor parts, both electrical and mechanical.\n"}</maint:sourceJSON>
