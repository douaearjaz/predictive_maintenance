  <rdf:Description rdf:about="https://example.org/maintenance/evidence/93eb57a0055f231c1847770b/0">
    <rdf:type rdf:resource="https://example.org/maintenance/Evidence"/>
    <maint:sourceJSON>{"bbox": [161.908203125, 370.08599853515625, 555.598388671875, 409.171142578125], "clean_end": 64, "clean_start": 18, "document_id": "DOC_db0cb8fe8ba6918158759135579681f3ed396ae6472dfe2655462ca20fb5c583", "document_name": "ac-troubleshooting-guide.pdf", "original_end": 65, "original_quote": "Test the winding for shorted or open circuits.", "original_start": 19, "page": 3, "paragraph_id": "P3_B9", "quote": "Test the winding for shorted or open circuits.", "section": "Defective winding", "section_id": "ac-winding", "source_paragraph_cleaned": "Defective winding Test the winding for shorted or open circuits. The amps may also be high. For defective winding, replace the motor.", "source_paragraph_original": "Defective winding \nTest the winding for shorted or open circuits. The \namps may also be high. For defective winding, \nreplace the motor. \n"}</maint:sourceJSON>
