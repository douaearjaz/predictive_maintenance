@prefix maint: <https://example.org/maintenance/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

maint: a owl:Ontology ;
    rdfs:comment "Draft vocabulary and source-scoped concepts. Relations describe reviewed claims, not universal causal axioms. Qualifiers and conditions must be consulted." ;
    owl:versionInfo "maintenance-ontology-v1" .

maint:Effect a owl:Class ;
    rdfs:label "Effect" ;
    rdfs:subClassOf maint:Concept .

maint:Function a owl:Class ;
    rdfs:label "Function" ;
    rdfs:subClassOf maint:Concept .

maint:UnclassifiedConcept a owl:Class ;
    rdfs:label "UnclassifiedConcept" ;
    rdfs:subClassOf maint:Concept .

maint:affects a owl:ObjectProperty ;
    rdfs:label "affects" .

maint:associatedWith a owl:ObjectProperty ;
    rdfs:label "associatedWith" .

maint:candidateId a owl:DatatypeProperty .

maint:conditionsJSON a owl:DatatypeProperty .

maint:documentId a owl:DatatypeProperty .

maint:hasEvidence a owl:ObjectProperty .

maint:hasFunction a owl:ObjectProperty ;
    rdfs:label "hasFunction" .

maint:originalRecordJSON a owl:DatatypeProperty .

maint:page a owl:DatatypeProperty .

maint:qualifier a owl:DatatypeProperty .

maint:quote a owl:DatatypeProperty .

maint:reviewJSON a owl:DatatypeProperty .

maint:runId a owl:DatatypeProperty .

maint:sectionId a owl:DatatypeProperty .

maint:sourceJSON a owl:DatatypeProperty .

