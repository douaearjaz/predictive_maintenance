    maint:sourceJSON "{\"bbox\": [308.9988098144531, 208.98248291015625, 560.1505737304688, 259.74090576171875], \"clean_end\": 154, \"clean_start\": 0, \"document_id\": \"DOC_eae8090d19d0478c75eda61af9c97af5953dc4395b339ef3c9806d9fa405e1ad\", \"document_name\": \"Manual_Udrzba_Montaz_TIMKEN_AJ.pdf\", \"original_end\": 154, \"original_quote\": \"Small areas of damage on bearing races, and on the contact sur-\\nface of the rolling elements, can sometimes be repaired by grind-\\ning out the loose metal.\", \"original_start\": 0, \"page\": 12, \"paragraph_id\": \"P12_B5\", \"quote\": \"Small areas of damage on bearing races, and on the contact sur- face of the rolling elements, can sometimes be repaired by grind- ing out the loose metal.\", \"section\": \"Bearing repair\", \"section_id\": \"timken-repair\", \"source_paragraph_cleaned\": \"Small areas of damage on bearing races, and on the contact sur- face of the rolling elements, can sometimes be repaired by grind- ing out the loose metal. Any raised or rough areas should be smoothed flat with grinding and polishing tools.\", \"source_paragraph_original\": \"Small areas of damage on bearing races, and on the contact sur-\\nface of the rolling elements, can sometimes be repaired by grind-\\ning out the loose metal. Any raised or rough areas should be \\nsmoothed flat with grinding and polishing tools. \\n\"}" .

<https://example.org/maintenance/evidence/359c70979d7ae870eead9a7f/0> a maint:Evidence ;
    maint:page 6 ;
    maint:quote "has lower efficiency" ;
    maint:sourceJSON "{\"bbox\": [268.7143249511719, 393.11505126953125, 542.9324951171875, 576.4556274414062], \"clean_end\": 78, \"clean_start\": 58, \"document_id\": \"DOC_bc4bdf2b43eb7832b16dfab1668af3e742a93a1cb1dbfd36ba2b901d5af6a371\", \"document_name\": \"13-common-causes.pdf\", \"original_end\": 79, \"original_quote\": \"has \\nlower efficiency\", \"original_start\": 58, \"page\": 6, \"paragraph_id\": \"P6_B5\", \"quote\": \"has lower efficiency\", \"section\": \"10 Bearing wear\", \"section_id\": \"fault-10\", \"source_paragraph_cleaned\": \"A failed bearing has increased drag, emits more heat, and has lower efficiency because of a mechanical, lubrication, or wear problem. Bearing failure can be caused by several things: • A heavier load than designed for • Inadequate or incorrect lubrication • Ineffective bearing sealing • Shaft misalignment • Incorrect fit • Normal wear • Induced shaft voltages Once bearing failure begins, it also creates a cascade effect that accelerates motor failure. 13 % of motor failures are caused by bearing failure, and more than 60 % of the mechanical failures in a facility are caused by bearing wear, so learning how to troubleshoot this potential problem is important.\", \"source_paragraph_original\": \"A failed bearing has increased drag, emits more heat, and has \\nlower efficiency because of a mechanical, lubrication, or wear  \\nproblem. Bearing failure can be caused by several things: \\n•\\t A heavier load than designed for\\n•\\t Inadequate or incorrect lubrication\\n•\\t Ineffective bearing sealing\\n•\\t Shaft misalignment \\n•\\t Incorrect fit\\n•\\t Normal wear\\n•\\t Induced shaft voltages\\nOnce bearing failure begins, it also creates a cascade effect that \\naccelerates motor failure. 13 % of motor failures are caused by  \\nbearing failure, and more than 60 % of the mechanical failures  \\nin a facility are caused by bearing wear, so learning how to \\ntroubleshoot this potential problem is important. \\n\"}" .

<https://example.org/maintenance/evidence/3f1bbccc1b32dbc1d23bebdb/0> a maint:Evidence ;
    maint:page 2 ;
    maint:quote "Imbalance creates excessive current flow in one or more phases" ;
    maint:sourceJSON "{\"bbox\": [268.71429443359375, 523.3394165039062, 547.9678344726562, 556.6939086914062], \"clean_end\": 70, \"clean_start\": 8, \"document_id\": \"DOC_bc4bdf2b43eb7832b16dfab1668af3e742a93a1cb1dbfd36ba2b901d5af6a371\", \"document_name\": \"13-common-causes.pdf\", \"original_end\": 71, \"original_quote\": \"Imbalance creates excessive current flow in one or more \\nphases\", \"original_start\": 8, \"page\": 2, \"paragraph_id\": \"P2_B6\", \"quote\": \"Imbalance creates excessive current flow in one or more phases\", \"section\": \"2 Voltage imbalance\", \"section_id\": \"fault-02\", \"source_paragraph_cleaned\": \"Impact: Imbalance creates excessive current flow in one or more phases that then increases operating temperatures–leading to insulation breakdown\", \"source_paragraph_original\": \"Impact: Imbalance creates excessive current flow in one or more \\nphases that then increases operating temperatures–leading to  \\ninsulation breakdown\\n\"}" .

