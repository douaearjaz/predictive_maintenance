    maint:originalRecordJSON "{\"evidence\": [{\"paragraph_id\": \"P6_B6\", \"quote\": \"Cause 3a: Input circuit single phased (No voltage in one or two phases; could have been a temporary condition).\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"failure_mode\", \"text\": \"Motor will not start (Just hums and heats up.)\"}, \"operating_conditions\": null, \"qualifier\": \"could have been a temporary condition\", \"relation\": \"CAUSES\", \"review_note\": \"\", \"subject\": {\"kind\": \"cause\", \"text\": \"Input circuit single phased\"}}" ;
    maint:qualifier "could have been a temporary condition" ;
    maint:reviewJSON "{\"candidate_hash\": \"8ec19341c8bacb10fd460b9210a91ddff548e7c4603601c8d778c4e0b3ab85f3\", \"candidate_id\": \"ATOM_f016bbaefd26a4ffd01b0a1b\", \"decision\": \"accepted\", \"note\": \"Source fidelity check only; technical approval pending. Lincoln Trouble 3 and Cause 3a are a numbered pair. Missing voltage in one/two phases is listed for motor not starting with hum/heating. Preserve the possible temporary-condition qualifier.\", \"reviewed_at\": \"2026-09-15T00:14:45.756310+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"12721e542a87b045002c420c\"}" ;
    maint:runId "12721e542a87b045002c420c" .

