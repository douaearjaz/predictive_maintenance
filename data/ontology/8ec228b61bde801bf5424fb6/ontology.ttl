    maint:sourceJSON "{\"bbox\": [62.63999557495117, 426.9633483886719, 510.0133361816406, 463.6756591796875], \"clean_end\": 174, \"clean_start\": 103, \"document_id\": \"DOC_cf0bdf9d28720ead73ea3680ce4f0d19dc8ff2f84bcf454378dea1215b51fa22\", \"document_name\": \"NP_7502_Electric Motor Predictive and Preventive Maintenance Guide.pdf\", \"original_end\": 174, \"original_quote\": \"It can also cause loss of lubrication capability in bearing oil systems\", \"original_start\": 103, \"page\": 54, \"paragraph_id\": \"P54_B6\", \"quote\": \"It can also cause loss of lubrication capability in bearing oil systems\", \"section\": \"Moisture and motor insulation\", \"section_id\": \"epri-moisture\", \"source_paragraph_cleaned\": \"Excessive Moisture. Excessive moisture causes failures in motor winding insulation and in motor leads. It can also cause loss of lubrication capability in bearing oil systems and deterioration of motor parts, both electrical and mechanical.\", \"source_paragraph_original\": \"Excessive Moisture. Excessive moisture causes failures in motor winding insulation and\\nin motor leads. It can also cause loss of lubrication capability in bearing oil systems and\\ndeterioration of motor parts, both electrical and mechanical.\\n\"}" .

<https://example.org/maintenance/evidence/ee099c73dbeacfb05d4a46a8/0> a maint:Evidence ;
    maint:page 3 ;
    maint:quote "An unbalanced load will also cause the bearings to fail." ;
    maint:sourceJSON "{\"bbox\": [319.6659851074219, 453.2501220703125, 559.1820068359375, 492.3273620605469], \"clean_end\": 142, \"clean_start\": 86, \"document_id\": \"DOC_db0cb8fe8ba6918158759135579681f3ed396ae6472dfe2655462ca20fb5c583\", \"document_name\": \"ac-troubleshooting-guide.pdf\", \"original_end\": 144, \"original_quote\": \"An unbalanced \\nload will also cause the bearings to fail.\", \"original_start\": 87, \"page\": 3, \"paragraph_id\": \"P3_B12\", \"quote\": \"An unbalanced load will also cause the bearings to fail.\", \"section\": \"Unbalanced load and bearing failure\", \"section_id\": \"ac-unbalanced-load\", \"source_paragraph_cleaned\": \"Check the motor load and inspect the drive belt tension to ensure it’s not too tight. An unbalanced load will also cause the bearings to fail.\", \"source_paragraph_original\": \"Check the motor load and inspect the drive belt \\ntension to ensure it’s not too tight. An unbalanced \\nload will also cause the bearings to fail. \\n\"}" .

