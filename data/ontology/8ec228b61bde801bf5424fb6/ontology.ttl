    maint:sourceJSON "{\"bbox\": [308.9988098144531, 208.98248291015625, 560.1505737304688, 259.74090576171875], \"clean_end\": 239, \"clean_start\": 155, \"document_id\": \"DOC_eae8090d19d0478c75eda61af9c97af5953dc4395b339ef3c9806d9fa405e1ad\", \"document_name\": \"Manual_Udrzba_Montaz_TIMKEN_AJ.pdf\", \"original_end\": 240, \"original_quote\": \"Any raised or rough areas should be \\nsmoothed flat with grinding and polishing tools.\", \"original_start\": 155, \"page\": 12, \"paragraph_id\": \"P12_B5\", \"quote\": \"Any raised or rough areas should be smoothed flat with grinding and polishing tools.\", \"section\": \"Bearing repair\", \"section_id\": \"timken-repair\", \"source_paragraph_cleaned\": \"Small areas of damage on bearing races, and on the contact sur- face of the rolling elements, can sometimes be repaired by grind- ing out the loose metal. Any raised or rough areas should be smoothed flat with grinding and polishing tools.\", \"source_paragraph_original\": \"Small areas of damage on bearing races, and on the contact sur-\\nface of the rolling elements, can sometimes be repaired by grind-\\ning out the loose metal. Any raised or rough areas should be \\nsmoothed flat with grinding and polishing tools. \\n\"}" .

