    maint:sourceJSON "{\"bbox\": [64.24980163574219, 563.8579711914062, 230.39425659179688, 593.6339111328125], \"clean_end\": 105, \"clean_start\": 0, \"document_id\": \"DOC_775874115de53f4ac9dfe96ef9fac58f3b2a9a0ae5697e5bff5c94110edaa6ec\", \"document_name\": \"Electric Motor Troubleshooting (Polyphase).pdf\", \"original_end\": 105, \"original_quote\": \"Cause 3b: Motor was single phased as\\nindicated by heat damage to one or two\\nphases of the motor windings.\", \"original_start\": 0, \"page\": 6, \"paragraph_id\": \"P6_B7\", \"quote\": \"Cause 3b: Motor was single phased as indicated by heat damage to one or two phases of the motor windings.\", \"section\": \"Motor will not start; hums and heats\", \"section_id\": \"lincoln-hums\", \"source_paragraph_cleaned\": \"Cause 3b: Motor was single phased as indicated by heat damage to one or two phases of the motor windings.\", \"source_paragraph_original\": \"Cause 3b: Motor was single phased as\\nindicated by heat damage to one or two\\nphases of the motor windings. \\n\"}" .

