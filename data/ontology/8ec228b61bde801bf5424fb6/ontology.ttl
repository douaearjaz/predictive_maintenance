<https://example.org/maintenance/evidence/8776ca91fd131c77d3bea2c1/0> a maint:Evidence ;
    maint:page 6 ;
    maint:quote "Cure 3b: Replace the motor. ALWAYS have an expert check the motor windings to determine whether the single phasing occurred in the input circuit or in the motor windings. If in the input circuit, correct the single phase condition." ;
    maint:sourceJSON "{\"bbox\": [262.0, 563.8579711914062, 540.30029296875, 603.6337890625], \"clean_end\": 231, \"clean_start\": 0, \"document_id\": \"DOC_775874115de53f4ac9dfe96ef9fac58f3b2a9a0ae5697e5bff5c94110edaa6ec\", \"document_name\": \"Electric Motor Troubleshooting (Polyphase).pdf\", \"original_end\": 231, \"original_quote\": \"Cure 3b: Replace the motor. ALWAYS have an expert check the\\nmotor windings to determine whether the single phasing occurred in\\nthe input circuit or in the motor windings. If in the input circuit, correct\\nthe single phase condition.\", \"original_start\": 0, \"page\": 6, \"paragraph_id\": \"P6_B10\", \"quote\": \"Cure 3b: Replace the motor. ALWAYS have an expert check the motor windings to determine whether the single phasing occurred in the input circuit or in the motor windings. If in the input circuit, correct the single phase condition.\", \"section\": \"Motor will not start; hums and heats\", \"section_id\": \"lincoln-hums\", \"source_paragraph_cleaned\": \"Cure 3b: Replace the motor. ALWAYS have an expert check the motor windings to determine whether the single phasing occurred in the input circuit or in the motor windings. If in the input circuit, correct the single phase condition.\", \"source_paragraph_original\": \"Cure 3b: Replace the motor. ALWAYS have an expert check the\\nmotor windings to determine whether the single phasing occurred in\\nthe input circuit or in the motor windings. If in the input circuit, correct\\nthe single phase condition.\\n\"}" .

<https://example.org/maintenance/evidence/879d056732df0d3ce5456f8b/0> a maint:Evidence ;
    maint:page 3 ;
    maint:quote "The amps may also be high." ;
    maint:sourceJSON "{\"bbox\": [161.908203125, 370.08599853515625, 555.598388671875, 409.171142578125], \"clean_end\": 91, \"clean_start\": 65, \"document_id\": \"DOC_db0cb8fe8ba6918158759135579681f3ed396ae6472dfe2655462ca20fb5c583\", \"document_name\": \"ac-troubleshooting-guide.pdf\", \"original_end\": 93, \"original_quote\": \"The \\namps may also be high.\", \"original_start\": 66, \"page\": 3, \"paragraph_id\": \"P3_B9\", \"quote\": \"The amps may also be high.\", \"section\": \"Defective winding\", \"section_id\": \"ac-winding\", \"source_paragraph_cleaned\": \"Defective winding Test the winding for shorted or open circuits. The amps may also be high. For defective winding, replace the motor.\", \"source_paragraph_original\": \"Defective winding \\nTest the winding for shorted or open circuits. The \\namps may also be high. For defective winding, \\nreplace the motor. \\n\"}" .

