<https://example.org/maintenance/evidence/2a0aca946f2f60d3b3422acb/0> a maint:Evidence ;
    maint:page 54 ;
    maint:quote "Excessive moisture causes failures in motor winding insulation and in motor leads" ;
    maint:sourceJSON "{\"bbox\": [62.63999557495117, 426.9633483886719, 510.0133361816406, 463.6756591796875], \"clean_end\": 101, \"clean_start\": 20, \"document_id\": \"DOC_cf0bdf9d28720ead73ea3680ce4f0d19dc8ff2f84bcf454378dea1215b51fa22\", \"document_name\": \"NP_7502_Electric Motor Predictive and Preventive Maintenance Guide.pdf\", \"original_end\": 101, \"original_quote\": \"Excessive moisture causes failures in motor winding insulation and\\nin motor leads\", \"original_start\": 20, \"page\": 54, \"paragraph_id\": \"P54_B6\", \"quote\": \"Excessive moisture causes failures in motor winding insulation and in motor leads\", \"section\": \"Moisture and motor insulation\", \"section_id\": \"epri-moisture\", \"source_paragraph_cleaned\": \"Excessive Moisture. Excessive moisture causes failures in motor winding insulation and in motor leads. It can also cause loss of lubrication capability in bearing oil systems and deterioration of motor parts, both electrical and mechanical.\", \"source_paragraph_original\": \"Excessive Moisture. Excessive moisture causes failures in motor winding insulation and\\nin motor leads. It can also cause loss of lubrication capability in bearing oil systems and\\ndeterioration of motor parts, both electrical and mechanical.\\n\"}" .

<https://example.org/maintenance/evidence/2cde022af30c5af2a371dcfa/0> a maint:Evidence ;
    maint:page 3 ;
    maint:quote "For defective winding, replace the motor." ;
    maint:sourceJSON "{\"bbox\": [161.908203125, 370.08599853515625, 555.598388671875, 409.171142578125], \"clean_end\": 133, \"clean_start\": 92, \"document_id\": \"DOC_db0cb8fe8ba6918158759135579681f3ed396ae6472dfe2655462ca20fb5c583\", \"document_name\": \"ac-troubleshooting-guide.pdf\", \"original_end\": 136, \"original_quote\": \"For defective winding, \\nreplace the motor.\", \"original_start\": 94, \"page\": 3, \"paragraph_id\": \"P3_B9\", \"quote\": \"For defective winding, replace the motor.\", \"section\": \"Defective winding\", \"section_id\": \"ac-winding\", \"source_paragraph_cleaned\": \"Defective winding Test the winding for shorted or open circuits. The amps may also be high. For defective winding, replace the motor.\", \"source_paragraph_original\": \"Defective winding \\nTest the winding for shorted or open circuits. The \\namps may also be high. For defective winding, \\nreplace the motor. \\n\"}" .

