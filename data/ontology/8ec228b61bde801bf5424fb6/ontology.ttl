    maint:sourceJSON "{\"bbox\": [262.0, 523.8578491210938, 544.138916015625, 543.6339111328125], \"clean_end\": 143, \"clean_start\": 0, \"document_id\": \"DOC_775874115de53f4ac9dfe96ef9fac58f3b2a9a0ae5697e5bff5c94110edaa6ec\", \"document_name\": \"Electric Motor Troubleshooting (Polyphase).pdf\", \"original_end\": 143, \"original_quote\": \"Cure 3a: Have a qualified technician check for the proper voltage in\\nall three phases. If a single phase condition exists, correct the problem.\", \"original_start\": 0, \"page\": 6, \"paragraph_id\": \"P6_B9\", \"quote\": \"Cure 3a: Have a qualified technician check for the proper voltage in all three phases. If a single phase condition exists, correct the problem.\", \"section\": \"Motor will not start; hums and heats\", \"section_id\": \"lincoln-hums\", \"source_paragraph_cleaned\": \"Cure 3a: Have a qualified technician check for the proper voltage in all three phases. If a single phase condition exists, correct the problem.\", \"source_paragraph_original\": \"Cure 3a: Have a qualified technician check for the proper voltage in\\nall three phases. If a single phase condition exists, correct the problem.\\n\"}" .

