    maint:originalRecordJSON "{\"evidence\": [{\"paragraph_id\": \"P6_B9\", \"quote\": \"Cure 3a: Have a qualified technician check for the proper voltage in all three phases. If a single phase condition exists, correct the problem.\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"maintenance_action\", \"text\": \"qualified technician check for the proper voltage in all three phases\"}, \"operating_conditions\": null, \"qualifier\": \"asserted\", \"relation\": \"MITIGATED_BY\", \"review_note\": \"\", \"subject\": {\"kind\": \"cause\", \"text\": \"Input circuit single phased\"}}" ;
