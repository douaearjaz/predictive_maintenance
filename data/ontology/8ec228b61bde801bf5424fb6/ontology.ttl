    maint:originalRecordJSON "{\"evidence\": [{\"paragraph_id\": \"P5_B3\", \"quote\": \"Fluke 830 Laser Shaft Alignment Tool to diagnose and correct misalignment\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"detection_method\", \"text\": \"Fluke 830 Laser Shaft Alignment Tool\"}, \"operating_conditions\": null, \"qualifier\": \"to diagnose and correct misalignment\", \"relation\": \"DETECTED_BY\", \"review_note\": \"\", \"subject\": {\"kind\": \"phenomenon\", \"text\": \"Misalignment\"}}" ;
    maint:qualifier "to diagnose and correct misalignment" ;
    maint:reviewJSON "{\"candidate_hash\": \"d51d2774cf40ab961f2c48879be3ebe820e5d92e92ce25592c2615a79c6a79a1\", \"candidate_id\": \"ATOM_d75d8df86607fbd2b7ae66d5\", \"decision\": \"accepted\", \"note\": \"Assistant verification only; human review pending. Page 5 explicitly links Fluke 830 Laser Shaft Alignment Tool to diagnosing and correcting misalignment. Accepted as detection; tool name alone is not a maintenance action.\", \"reviewed_at\": \"2026-09-14T21:02:35.381912+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"c7f8842146507b286f377664\"}" ;
    maint:runId "c7f8842146507b286f377664" .

<https://example.org/maintenance/statement/126d1de5d4fb26fc3582dd08> a rdf:Statement,
        maint:EvidenceStatement ;
