    motor:metadataJSON "{\"applicability\": \"general_bearing_guidance_motor_applicability_pending\", \"candidate_id\": \"ATOM_63a773250aa608fceab198ca\", \"document_id\": \"DOC_eae8090d19d0478c75eda61af9c97af5953dc4395b339ef3c9806d9fa405e1ad\", \"document_name\": \"Manual_Udrzba_Montaz_TIMKEN_AJ.pdf\", \"evidence\": [{\"bbox\": [41.99760055541992, 601.0715942382812, 293.1300964355469, 690.818115234375], \"clean_end\": 274, \"clean_start\": 212, \"document_id\": \"DOC_eae8090d19d0478c75eda61af9c97af5953dc4395b339ef3c9806d9fa405e1ad\", \"document_name\": \"Manual_Udrzba_Montaz_TIMKEN_AJ.pdf\", \"original_end\": 277, \"original_quote\": \"may still be returned to service after \\nrepair or refurbishment\", \"original_start\": 214, \"page\": 12, \"paragraph_id\": \"P12_B24\", \"quote\": \"may still be returned to service after repair or refurbishment\", \"section\": \"Damaged bearings\", \"section_id\": \"timken-damage\", \"source_paragraph_cleaned\": \"Despite taking proper precautions, bearings may become dam- aged either through improper storage and handling or through normal wear in use. Bearings that have been damaged or are no longer within specifications may still be returned to service after repair or refurbishment. Some bearings can be refurbished more than once. Eventually all bearings will sustain sufficient wear or damage and will have to be replaced.\", \"source_paragraph_original\": \"Despite taking proper precautions, bearings may become dam-\\naged either through improper storage and handling or through \\nnormal wear in use. Bearings that have been damaged or are no \\nlonger within specifications may still be returned to service after \\nrepair or refurbishment. Some bearings can be refurbished more \\nthan once. Eventually all bearings will sustain sufficient wear or \\ndamage and will have to be replaced.\\n\"}], \"id\": \"cfe1edb8b29d288904fa84c8\", \"layer\": \"source_claim\", \"object\": \"source_5ff30c425743d0039992c481\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P12_B24\", \"quote\": \"may still be returned to service after repair or refurbishment\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"maintenance_action\", \"text\": \"repair or refurbishment\"}, \"operating_conditions\": null, \"qualifier\": \"may\", \"relation\": \"MITIGATED_BY\", \"review_note\": \"\", \"subject\": {\"kind\": \"failure_mode\", \"text\": \"damaged bearing\"}}, \"qualifier\": \"may\", \"relation\": \"MITIGATED_BY\", \"review\": {\"candidate_hash\": \"ea6ddf5b805e583ba2571b116cba27a533eb5bda0cef6b40b75cb8d8d52acf1b\", \"candidate_id\": \"ATOM_63a773250aa608fceab198ca\", \"decision\": \"accepted\", \"note\": \"Source fidelity check only; technical approval pending. Timken says damaged/out-of-spec bearings MAY be returned to service after repair/refurbishment. This is a possible source-stated action, not authorization to return a specific bearing to service.\", \"reviewed_at\": \"2026-09-15T00:14:45.744921+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"b54ac34af4791ab118c217cf\"}, \"run_id\": \"b54ac34af4791ab118c217cf\", \"section\": \"Damaged bearings\", \"section_id\": \"timken-damage\", \"source_object\": \"5ff30c425743d0039992c481\", \"source_subject\": \"3a8d8364b4f2a04eede7a21b\", \"subject\": \"source_3a8d8364b4f2a04eede7a21b\", \"topic\": \"topic_bearings\", \"warnings\": [\"endpoint_not_literal_in_quote_check_full_paragraph\"]}" ;
    motor:qualifier "may" .

