    motor:metadataJSON "{\"applicability\": \"source_context_only\", \"candidate_id\": \"ATOM_1bb70b9b94cbc4164f33eaa3\", \"document_id\": \"DOC_cf0bdf9d28720ead73ea3680ce4f0d19dc8ff2f84bcf454378dea1215b51fa22\", \"document_name\": \"NP_7502_Electric Motor Predictive and Preventive Maintenance Guide.pdf\", \"evidence\": [{\"bbox\": [62.63999557495117, 426.9633483886719, 510.0133361816406, 463.6756591796875], \"clean_end\": 82, \"clean_start\": 20, \"document_id\": \"DOC_cf0bdf9d28720ead73ea3680ce4f0d19dc8ff2f84bcf454378dea1215b51fa22\", \"document_name\": \"NP_7502_Electric Motor Predictive and Preventive Maintenance Guide.pdf\", \"original_end\": 82, \"original_quote\": \"Excessive moisture causes failures in motor winding insulation\", \"original_start\": 20, \"page\": 54, \"paragraph_id\": \"P54_B6\", \"quote\": \"Excessive moisture causes failures in motor winding insulation\", \"section\": \"Moisture and motor insulation\", \"section_id\": \"epri-moisture\", \"source_paragraph_cleaned\": \"Excessive Moisture. Excessive moisture causes failures in motor winding insulation and in motor leads. It can also cause loss of lubrication capability in bearing oil systems and deterioration of motor parts, both electrical and mechanical.\", \"source_paragraph_original\": \"Excessive Moisture. Excessive moisture causes failures in motor winding insulation and\\nin motor leads. It can also cause loss of lubrication capability in bearing oil systems and\\ndeterioration of motor parts, both electrical and mechanical.\\n\"}], \"id\": \"bd5aabae7d89f217e55defb2\", \"layer\": \"source_claim\", \"object\": \"source_ca8ec9df9497bb11f57eb198\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P54_B6\", \"quote\": \"Excessive moisture causes failures in motor winding insulation\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"failure_mode\", \"text\": \"failures in motor winding insulation\"}, \"operating_conditions\": null, \"qualifier\": \"causes\", \"relation\": \"CAUSES\", \"review_note\": \"\", \"subject\": {\"kind\": \"phenomenon\", \"text\": \"excessive moisture\"}}, \"qualifier\": \"causes\", \"relation\": \"CAUSES\", \"review\": {\"candidate_hash\": \"43faf390c41f0f6611953231dbff80911526d057dad4603b4e7a7064455cf31b\", \"candidate_id\": \"ATOM_1bb70b9b94cbc4164f33eaa3\", \"decision\": \"accepted\", \"note\": \"Source fidelity check only; technical approval pending. EPRI Excessive Moisture paragraph directly states moisture causes failures in motor winding insulation.\", \"reviewed_at\": \"2026-09-15T00:14:45.782852+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"fbbf87da083d3d923af71181\"}, \"run_id\": \"fbbf87da083d3d923af71181\", \"section\": \"Moisture and motor insulation\", \"section_id\": \"epri-moisture\", \"source_object\": \"ca8ec9df9497bb11f57eb198\", \"source_subject\": \"8d39968b9dde89d029336004\", \"subject\": \"source_8d39968b9dde89d029336004\", \"topic\": \"topic_moisture\", \"warnings\": []}" ;
