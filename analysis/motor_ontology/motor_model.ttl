    motor:metadataJSON "{\"applicability\": \"general_bearing_guidance_motor_applicability_pending\", \"candidate_id\": \"ATOM_3bed7679bf1ef121ae9d471c\", \"document_id\": \"DOC_eae8090d19d0478c75eda61af9c97af5953dc4395b339ef3c9806d9fa405e1ad\", \"document_name\": \"Manual_Udrzba_Montaz_TIMKEN_AJ.pdf\", \"evidence\": [{\"bbox\": [308.99884033203125, 269.972412109375, 560.1600341796875, 320.7309265136719], \"clean_end\": 78, \"clean_start\": 0, \"document_id\": \"DOC_eae8090d19d0478c75eda61af9c97af5953dc4395b339ef3c9806d9fa405e1ad\", \"document_name\": \"Manual_Udrzba_Montaz_TIMKEN_AJ.pdf\", \"original_end\": 79, \"original_quote\": \"Light rust or corrosion should be removed with emery paper \\n(240 \\u2013 320 # grit).\", \"original_start\": 0, \"page\": 12, \"paragraph_id\": \"P12_B6\", \"quote\": \"Light rust or corrosion should be removed with emery paper (240 \\u2013 320 # grit).\", \"section\": \"Bearing repair\", \"section_id\": \"timken-repair\", \"source_paragraph_cleaned\": \"Light rust or corrosion should be removed with emery paper (240 \\u2013 320 # grit). As much of the damage should be removed as possible to prevent it from contaminating the bearing when it is returned to service.\", \"source_paragraph_original\": \"Light rust or corrosion should be removed with emery paper \\n(240 \\u2013 320 # grit). As much of the damage should be removed as \\npossible to prevent it from contaminating the bearing when it is \\nreturned to service.\\n\"}], \"id\": \"cf543ea5b4489c9001c917ac\", \"layer\": \"source_claim\", \"object\": \"source_a7319cf89569b1fdbbe06b7e\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P12_B6\", \"quote\": \"Light rust or corrosion should be removed with emery paper (240 \\u2013 320 # grit).\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"maintenance_action\", \"text\": \"removal with emery paper (240 \\u2013 320 # grit)\"}, \"operating_conditions\": null, \"qualifier\": \"should\", \"relation\": \"MITIGATED_BY\", \"review_note\": \"\", \"subject\": {\"kind\": \"failure_mode\", \"text\": \"Light rust or corrosion\"}}, \"qualifier\": \"should\", \"relation\": \"MITIGATED_BY\", \"review\": {\"candidate_hash\": \"02a7cd51406238e539466f906a7d7ff16e47276c5083148b8fcd0b05afb58b2a\", \"candidate_id\": \"ATOM_3bed7679bf1ef121ae9d471c\", \"decision\": \"accepted\", \"note\": \"Source fidelity check only; technical approval pending. Timken explicitly limits this recommendation to LIGHT rust/corrosion and specifies emery paper 240\\u2013320 grit. Wording and scope retained.\", \"reviewed_at\": \"2026-09-15T00:14:45.730906+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"b54ac34af4791ab118c217cf\"}, \"run_id\": \"b54ac34af4791ab118c217cf\", \"section\": \"Bearing repair\", \"section_id\": \"timken-repair\", \"source_object\": \"a7319cf89569b1fdbbe06b7e\", \"source_subject\": \"d038b71c6f66ded73ea5057b\", \"subject\": \"source_d038b71c6f66ded73ea5057b\", \"topic\": \"topic_bearings\", \"warnings\": [\"endpoint_not_literal_in_quote_check_full_paragraph\"]}" ;
