    motor:metadataJSON "{\"applicability\": \"source_context_only\", \"candidate_id\": \"ATOM_2ae450641edcff529e874cbe\", \"document_id\": \"DOC_bc4bdf2b43eb7832b16dfab1668af3e742a93a1cb1dbfd36ba2b901d5af6a371\", \"document_name\": \"13-common-causes.pdf\", \"evidence\": [{\"bbox\": [268.71429443359375, 523.3394165039062, 547.9678344726562, 556.6939086914062], \"clean_end\": 145, \"clean_start\": 114, \"document_id\": \"DOC_bc4bdf2b43eb7832b16dfab1668af3e742a93a1cb1dbfd36ba2b901d5af6a371\", \"document_name\": \"13-common-causes.pdf\", \"original_end\": 148, \"original_quote\": \"leading to  \\ninsulation breakdown\", \"original_start\": 115, \"page\": 2, \"paragraph_id\": \"P2_B6\", \"quote\": \"leading to insulation breakdown\", \"section\": \"2 Voltage imbalance\", \"section_id\": \"fault-02\", \"source_paragraph_cleaned\": \"Impact: Imbalance creates excessive current flow in one or more phases that then increases operating temperatures\\u2013leading to insulation breakdown\", \"source_paragraph_original\": \"Impact: Imbalance creates excessive current flow in one or more \\nphases that then increases operating temperatures\\u2013leading to  \\ninsulation breakdown\\n\"}], \"id\": \"ef31f4e6fb0e61b459a294a9\", \"layer\": \"source_claim\", \"object\": \"source_14847406bc4f6a37d5a7d428\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P2_B6\", \"quote\": \"leading to insulation breakdown\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"failure_mode\", \"text\": \"insulation breakdown\"}, \"operating_conditions\": null, \"qualifier\": \"leading to\", \"relation\": \"LEADS_TO\", \"review_note\": \"\", \"subject\": {\"kind\": \"phenomenon\", \"text\": \"increased operating temperatures\"}}, \"qualifier\": \"leading to\", \"relation\": \"LEADS_TO\", \"review\": {\"candidate_hash\": \"518d713b0949346108f5ddc00dbb59a228a54092e13b1eb5dd306e69c7163f0a\", \"candidate_id\": \"ATOM_2ae450641edcff529e874cbe\", \"decision\": \"accepted\", \"note\": \"Checked the full source paragraph and immediate causal step\", \"reviewed_at\": \"2026-09-14T23:34:45.219853+00:00\", \"reviewer\": \"Your name\", \"reviewer_kind\": \"human\", \"run_id\": \"c7f8842146507b286f377664\"}, \"run_id\": \"c7f8842146507b286f377664\", \"section\": \"2 Voltage imbalance\", \"section_id\": \"fault-02\", \"source_object\": \"14847406bc4f6a37d5a7d428\", \"source_subject\": \"aa62ea44ba9d0cfbd82b8584\", \"subject\": \"source_aa62ea44ba9d0cfbd82b8584\", \"topic\": \"topic_power\", \"warnings\": [\"endpoint_not_literal_in_quote_check_full_paragraph\"]}" ;
