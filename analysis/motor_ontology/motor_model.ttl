    motor:metadataJSON "{\"applicability\": \"general_bearing_guidance_motor_applicability_pending\", \"candidate_id\": \"ATOM_746f878784f5f3466d623b82\", \"document_id\": \"DOC_eae8090d19d0478c75eda61af9c97af5953dc4395b339ef3c9806d9fa405e1ad\", \"document_name\": \"Manual_Udrzba_Montaz_TIMKEN_AJ.pdf\", \"evidence\": [{\"bbox\": [308.9988098144531, 208.98248291015625, 560.1505737304688, 259.74090576171875], \"clean_end\": 154, \"clean_start\": 0, \"document_id\": \"DOC_eae8090d19d0478c75eda61af9c97af5953dc4395b339ef3c9806d9fa405e1ad\", \"document_name\": \"Manual_Udrzba_Montaz_TIMKEN_AJ.pdf\", \"original_end\": 154, \"original_quote\": \"Small areas of damage on bearing races, and on the contact sur-\\nface of the rolling elements, can sometimes be repaired by grind-\\ning out the loose metal.\", \"original_start\": 0, \"page\": 12, \"paragraph_id\": \"P12_B5\", \"quote\": \"Small areas of damage on bearing races, and on the contact sur- face of the rolling elements, can sometimes be repaired by grind- ing out the loose metal.\", \"section\": \"Bearing repair\", \"section_id\": \"timken-repair\", \"source_paragraph_cleaned\": \"Small areas of damage on bearing races, and on the contact sur- face of the rolling elements, can sometimes be repaired by grind- ing out the loose metal. Any raised or rough areas should be smoothed flat with grinding and polishing tools.\", \"source_paragraph_original\": \"Small areas of damage on bearing races, and on the contact sur-\\nface of the rolling elements, can sometimes be repaired by grind-\\ning out the loose metal. Any raised or rough areas should be \\nsmoothed flat with grinding and polishing tools. \\n\"}], \"id\": \"342cd87f6f9db8d51c73ab99\", \"layer\": \"source_claim\", \"object\": \"source_47693d0de47db914ab787e2f\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P12_B5\", \"quote\": \"Small areas of damage on bearing races, and on the contact sur- face of the rolling elements, can sometimes be repaired by grind- ing out the loose metal.\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"maintenance_action\", \"text\": \"grinding out the loose metal\"}, \"operating_conditions\": null, \"qualifier\": \"can sometimes\", \"relation\": \"MITIGATED_BY\", \"review_note\": \"\", \"subject\": {\"kind\": \"failure_mode\", \"text\": \"Small areas of damage on the contact surface of the rolling elements\"}}, \"qualifier\": \"can sometimes\", \"relation\": \"MITIGATED_BY\", \"review\": {\"candidate_hash\": \"d358bea9907e920126d4e25b803aa4596f90fcb4a46882277a7e2b3656e6d78f\", \"candidate_id\": \"ATOM_746f878784f5f3466d623b82\", \"decision\": \"accepted\", \"note\": \"Source fidelity check only; technical approval pending. Timken same repair sentence includes small areas on rolling-element contact surfaces. Can sometimes is preserved. No blanket bearing-repair approval.\", \"reviewed_at\": \"2026-09-15T00:14:45.721316+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"b54ac34af4791ab118c217cf\"}, \"run_id\": \"b54ac34af4791ab118c217cf\", \"section\": \"Bearing repair\", \"section_id\": \"timken-repair\", \"source_object\": \"47693d0de47db914ab787e2f\", \"source_subject\": \"e87703217160eb52d24c919e\", \"subject\": \"source_e87703217160eb52d24c919e\", \"topic\": \"topic_bearings\", \"warnings\": [\"endpoint_not_literal_in_quote_check_full_paragraph\"]}" ;
