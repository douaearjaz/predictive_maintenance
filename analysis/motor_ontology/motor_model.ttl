    motor:metadataJSON "{\"applicability\": \"source_context_only\", \"candidate_id\": \"ATOM_73b9e02febb78923708b56bd\", \"document_id\": \"DOC_90dca734e4b5699ff37901e18cdb90275e77ded8b355359130c493820d2fa913\", \"document_name\": \"3GZF500730-85 RevH_EN 06-2022_lowres.pdf\", \"evidence\": [{\"bbox\": [129.92129516601562, 327.0812072753906, 519.0681762695312, 335.97821044921875], \"clean_end\": 75, \"clean_start\": 33, \"document_id\": \"DOC_90dca734e4b5699ff37901e18cdb90275e77ded8b355359130c493820d2fa913\", \"document_name\": \"3GZF500730-85 RevH_EN 06-2022_lowres.pdf\", \"original_end\": 75, \"original_quote\": \"Replace fuses with proper type and rating.\", \"original_start\": 33, \"page\": 25, \"paragraph_id\": \"P25_B6\", \"quote\": \"Replace fuses with proper type and rating.\", \"section\": \"Motor fails to start \\u2014 fuses\", \"section_id\": \"abb-start-fuses\", \"source_paragraph_cleaned\": \"Motor fails to start Blown fuses Replace fuses with proper type and rating.\", \"source_paragraph_original\": \"Motor fails to start\\nBlown fuses\\nReplace fuses with proper type and rating.\\n\"}], \"id\": \"8864ea2d3f211535c680a709\", \"layer\": \"source_claim\", \"object\": \"source_3764955ec0ecd3275efc3270\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P25_B6\", \"quote\": \"Replace fuses with proper type and rating.\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"maintenance_action\", \"text\": \"Replace fuses with proper type and rating.\"}, \"operating_conditions\": null, \"qualifier\": \"asserted\", \"relation\": \"MITIGATED_BY\", \"review_note\": \"\", \"subject\": {\"kind\": \"cause\", \"text\": \"Blown fuses\"}}, \"qualifier\": \"asserted\", \"relation\": \"MITIGATED_BY\", \"review\": {\"candidate_hash\": \"55ff32ef440420646cd34dd43584a8b0837ee213da1463c9418ed6e70fededa1\", \"candidate_id\": \"ATOM_73b9e02febb78923708b56bd\", \"decision\": \"accepted\", \"note\": \"Source fidelity check only; technical approval pending. ABB same row ties replacement with proper type and rating specifically to blown fuses. Keep this remedy on the blown-fuse scenario.\", \"reviewed_at\": \"2026-09-15T00:14:45.666884+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"2cc983acb246bd929a89ac82\"}, \"run_id\": \"2cc983acb246bd929a89ac82\", \"section\": \"Motor fails to start \\u2014 fuses\", \"section_id\": \"abb-start-fuses\", \"source_object\": \"3764955ec0ecd3275efc3270\", \"source_subject\": \"dea8beed2ee696f59a98f048\", \"subject\": \"source_dea8beed2ee696f59a98f048\", \"topic\": \"topic_starting\", \"warnings\": [\"endpoint_not_literal_in_quote_check_full_paragraph\"]}" ;
