    motor:metadataJSON "{\"applicability\": \"source_context_only\", \"candidate_id\": \"ATOM_27cd90f90e7302652c53d5b8\", \"document_id\": \"DOC_90dca734e4b5699ff37901e18cdb90275e77ded8b355359130c493820d2fa913\", \"document_name\": \"3GZF500730-85 RevH_EN 06-2022_lowres.pdf\", \"evidence\": [{\"bbox\": [129.922119140625, 522.1167602539062, 467.7701416015625, 531.0137329101562], \"clean_end\": 34, \"clean_start\": 13, \"document_id\": \"DOC_90dca734e4b5699ff37901e18cdb90275e77ded8b355359130c493820d2fa913\", \"document_name\": \"3GZF500730-85 RevH_EN 06-2022_lowres.pdf\", \"original_end\": 34, \"original_quote\": \"One phase may be open\", \"original_start\": 13, \"page\": 25, \"paragraph_id\": \"P25_B16\", \"quote\": \"One phase may be open\", \"section\": \"Motor stalls\", \"section_id\": \"abb-stalls\", \"source_paragraph_cleaned\": \"Motor stalls One phase may be open Check lines for open phase.\", \"source_paragraph_original\": \"Motor stalls\\nOne phase may be open\\nCheck lines for open phase.\\n\"}, {\"bbox\": [129.922119140625, 522.1167602539062, 467.7701416015625, 531.0137329101562], \"clean_end\": 12, \"clean_start\": 0, \"document_id\": \"DOC_90dca734e4b5699ff37901e18cdb90275e77ded8b355359130c493820d2fa913\", \"document_name\": \"3GZF500730-85 RevH_EN 06-2022_lowres.pdf\", \"original_end\": 12, \"original_quote\": \"Motor stalls\", \"original_start\": 0, \"page\": 25, \"paragraph_id\": \"P25_B16\", \"quote\": \"Motor stalls\", \"section\": \"Motor stalls\", \"section_id\": \"abb-stalls\", \"source_paragraph_cleaned\": \"Motor stalls One phase may be open Check lines for open phase.\", \"source_paragraph_original\": \"Motor stalls\\nOne phase may be open\\nCheck lines for open phase.\\n\"}], \"id\": \"f4684ea80a740ca7e3ac66b0\", \"layer\": \"source_claim\", \"object\": \"source_e9f885693731476bc1713860\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P25_B16\", \"quote\": \"One phase may be open\"}, {\"paragraph_id\": \"P25_B16\", \"quote\": \"Motor stalls\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"failure_mode\", \"text\": \"Motor stalls\"}, \"operating_conditions\": null, \"qualifier\": \"may\", \"relation\": \"CAUSES\", \"review_note\": \"\", \"subject\": {\"kind\": \"cause\", \"text\": \"One phase may be open\"}}, \"qualifier\": \"may\", \"relation\": \"CAUSES\", \"review\": {\"candidate_hash\": \"f227fa8fca18c90ac8505ce586b8dcb7461315f6c99d59989b7711d371d68559\", \"candidate_id\": \"ATOM_27cd90f90e7302652c53d5b8\", \"decision\": \"accepted\", \"note\": \"Source fidelity check only; technical approval pending. ABB Motor stalls row says One phase may be open. Checked fault and cause cells; preserve may.\", \"reviewed_at\": \"2026-09-15T00:14:45.670801+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"2cc983acb246bd929a89ac82\"}, \"run_id\": \"2cc983acb246bd929a89ac82\", \"section\": \"Motor stalls\", \"section_id\": \"abb-stalls\", \"source_object\": \"e9f885693731476bc1713860\", \"source_subject\": \"7d28f2916e29761139c350db\", \"subject\": \"source_7d28f2916e29761139c350db\", \"topic\": \"topic_stalling\", \"warnings\": []}" ;
