    motor:metadataJSON "{\"applicability\": \"source_context_only\", \"candidate_id\": \"ATOM_b16354a2d4283e594ec23a22\", \"document_id\": \"DOC_bc4bdf2b43eb7832b16dfab1668af3e742a93a1cb1dbfd36ba2b901d5af6a371\", \"document_name\": \"13-common-causes.pdf\", \"evidence\": [{\"bbox\": [268.7143249511719, 393.11505126953125, 542.9324951171875, 576.4556274414062], \"clean_end\": 255, \"clean_start\": 220, \"document_id\": \"DOC_bc4bdf2b43eb7832b16dfab1668af3e742a93a1cb1dbfd36ba2b901d5af6a371\", \"document_name\": \"13-common-causes.pdf\", \"original_end\": 261, \"original_quote\": \"Inadequate or incorrect lubrication\", \"original_start\": 226, \"page\": 6, \"paragraph_id\": \"P6_B5\", \"quote\": \"Inadequate or incorrect lubrication\", \"section\": \"10 Bearing wear\", \"section_id\": \"fault-10\", \"source_paragraph_cleaned\": \"A failed bearing has increased drag, emits more heat, and has lower efficiency because of a mechanical, lubrication, or wear problem. Bearing failure can be caused by several things: \\u2022 A heavier load than designed for \\u2022 Inadequate or incorrect lubrication \\u2022 Ineffective bearing sealing \\u2022 Shaft misalignment \\u2022 Incorrect fit \\u2022 Normal wear \\u2022 Induced shaft voltages Once bearing failure begins, it also creates a cascade effect that accelerates motor failure. 13 % of motor failures are caused by bearing failure, and more than 60 % of the mechanical failures in a facility are caused by bearing wear, so learning how to troubleshoot this potential problem is important.\", \"source_paragraph_original\": \"A failed bearing has increased drag, emits more heat, and has \\nlower efficiency because of a mechanical, lubrication, or wear  \\nproblem. Bearing failure can be caused by several things: \\n\\u2022\\t A heavier load than designed for\\n\\u2022\\t Inadequate or incorrect lubrication\\n\\u2022\\t Ineffective bearing sealing\\n\\u2022\\t Shaft misalignment \\n\\u2022\\t Incorrect fit\\n\\u2022\\t Normal wear\\n\\u2022\\t Induced shaft voltages\\nOnce bearing failure begins, it also creates a cascade effect that \\naccelerates motor failure. 13\\u2006% of motor failures are caused by  \\nbearing failure, and more than 60\\u2006% of the mechanical failures  \\nin a facility are caused by bearing wear, so learning how to \\ntroubleshoot this potential problem is important. \\n\"}], \"id\": \"fb6c9fcc10b12a441b67d9fd\", \"layer\": \"source_claim\", \"object\": \"term_bearing_failure\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P6_B5\", \"quote\": \"Inadequate or incorrect lubrication\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"failure_mode\", \"text\": \"bearing failure\"}, \"operating_conditions\": null, \"qualifier\": \"can\", \"relation\": \"CAUSES\", \"review_note\": \"\", \"subject\": {\"kind\": \"cause\", \"text\": \"inadequate or incorrect lubrication\"}}, \"qualifier\": \"can\", \"relation\": \"CAUSES\", \"review\": {\"candidate_hash\": \"cc3c2bd8e1da12441f94d5aa1f5fda94a2122f4203b5072f49896ae30d9e9ac2\", \"candidate_id\": \"ATOM_b16354a2d4283e594ec23a22\", \"decision\": \"accepted\", \"note\": \"Assistant verification only; human review pending. Page 6 P6_B5 explicitly introduces causes of bearing failure and lists inadequate or incorrect lubrication. Quotation is a list item; full paragraph supplies the causal introduction. Retain can, not deterministic causality.\", \"reviewed_at\": \"2026-09-14T21:02:35.094692+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"c7f8842146507b286f377664\"}, \"run_id\": \"c7f8842146507b286f377664\", \"section\": \"10 Bearing wear\", \"section_id\": \"fault-10\", \"source_object\": \"556e1a8b7ae2513b1170a312\", \"source_subject\": \"d6e52242a24f69608269165f\", \"subject\": \"source_d6e52242a24f69608269165f\", \"topic\": \"topic_bearings\", \"warnings\": [\"endpoint_not_literal_in_quote_check_full_paragraph\", \"qualifier_not_literal_in_evi