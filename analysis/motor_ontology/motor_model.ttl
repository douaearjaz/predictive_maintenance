    motor:metadataJSON "{\"applicability\": \"source_context_only\", \"candidate_id\": \"ATOM_3698cc5ebf1672810927391f\", \"document_id\": \"DOC_cf0bdf9d28720ead73ea3680ce4f0d19dc8ff2f84bcf454378dea1215b51fa22\", \"document_name\": \"NP_7502_Electric Motor Predictive and Preventive Maintenance Guide.pdf\", \"evidence\": [{\"bbox\": [62.63999557495117, 426.9633483886719, 510.0133361816406, 463.6756591796875], \"clean_end\": 239, \"clean_start\": 175, \"document_id\": \"DOC_cf0bdf9d28720ead73ea3680ce4f0d19dc8ff2f84bcf454378dea1215b51fa22\", \"document_name\": \"NP_7502_Electric Motor Predictive and Preventive Maintenance Guide.pdf\", \"original_end\": 239, \"original_quote\": \"and\\ndeterioration of motor parts, both electrical and mechanical\", \"original_start\": 175, \"page\": 54, \"paragraph_id\": \"P54_B6\", \"quote\": \"and deterioration of motor parts, both electrical and mechanical\", \"section\": \"Moisture and motor insulation\", \"section_id\": \"epri-moisture\", \"source_paragraph_cleaned\": \"Excessive Moisture. Excessive moisture causes failures in motor winding insulation and in motor leads. It can also cause loss of lubrication capability in bearing oil systems and deterioration of motor parts, both electrical and mechanical.\", \"source_paragraph_original\": \"Excessive Moisture. Excessive moisture causes failures in motor winding insulation and\\nin motor leads. It can also cause loss of lubrication capability in bearing oil systems and\\ndeterioration of motor parts, both electrical and mechanical.\\n\"}], \"id\": \"bf9b48893740bf3fa357d453\", \"layer\": \"source_claim\", \"object\": \"source_21d371edd377502047663bbd\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P54_B6\", \"quote\": \"and deterioration of motor parts, both electrical and mechanical\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"failure_mode\", \"text\": \"deterioration of motor parts, both electrical and mechanical\"}, \"operating_conditions\": null, \"qualifier\": \"can also cause\", \"relation\": \"CAUSES\", \"review_note\": \"\", \"subject\": {\"kind\": \"phenomenon\", \"text\": \"excessive moisture\"}}, \"qualifier\": \"can also cause\", \"relation\": \"CAUSES\", \"review\": {\"candidate_hash\": \"981111564b0c738dbb631dfde24885d3630febb98e9c7ff1ccf6dc27cb87d1f3\", \"candidate_id\": \"ATOM_3698cc5ebf1672810927391f\", \"decision\": \"accepted\", \"note\": \"Source fidelity check only; technical approval pending. EPRI same sentence explicitly includes deterioration of electrical/mechanical motor parts. Full paragraph resolves subject and preserves can.\", \"reviewed_at\": \"2026-09-15T00:14:45.807230+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"fbbf87da083d3d923af71181\"}, \"run_id\": \"fbbf87da083d3d923af71181\", \"section\": \"Moisture and motor insulation\", \"section_id\": \"epri-moisture\", \"source_object\": \"21d371edd377502047663bbd\", \"source_subject\": \"8d39968b9dde89d029336004\", \"subject\": \"source_8d39968b9dde89d029336004\", \"topic\": \"topic_moisture\", \"warnings\": [\"endpoint_not_literal_in_quote_check_full_paragraph\", \"qualifier_not_literal_in_evidence\"]}" ;
