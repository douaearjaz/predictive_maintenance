    motor:metadataJSON "{\"applicability\": \"source_context_only\", \"candidate_id\": \"ATOM_0153036d6c027108276dbfc6\", \"document_id\": \"DOC_bc4bdf2b43eb7832b16dfab1668af3e742a93a1cb1dbfd36ba2b901d5af6a371\", \"document_name\": \"13-common-causes.pdf\", \"evidence\": [{\"bbox\": [268.7143249511719, 393.11505126953125, 542.9324951171875, 576.4556274414062], \"clean_end\": 322, \"clean_start\": 309, \"document_id\": \"DOC_bc4bdf2b43eb7832b16dfab1668af3e742a93a1cb1dbfd36ba2b901d5af6a371\", \"document_name\": \"13-common-causes.pdf\", \"original_end\": 332, \"original_quote\": \"Incorrect fit\", \"original_start\": 319, \"page\": 6, \"paragraph_id\": \"P6_B5\", \"quote\": \"Incorrect fit\", \"section\": \"10 Bearing wear\", \"section_id\": \"fault-10\", \"source_paragraph_cleaned\": \"A failed bearing has increased drag, emits more heat, and has lower efficiency because of a mechanical, lubrication, or wear problem. Bearing failure can be caused by several things: \\u2022 A heavier load than designed for \\u2022 Inadequate or incorrect lubrication \\u2022 Ineffective bearing sealing \\u2022 Shaft misalignment \\u2022 Incorrect fit \\u2022 Normal wear \\u2022 Induced shaft voltages Once bearing failure begins, it also creates a cascade effect that accelerates motor failure. 13 % of motor failures are caused by bearing failure, and more than 60 % of the mechanical failures in a facility are caused by bearing wear, so learning how to troubleshoot this potential problem is important.\", \"source_paragraph_original\": \"A failed bearing has increased drag, emits more heat, and has \\nlower efficiency because of a mechanical, lubrication, or wear  \\nproblem. Bearing failure can be caused by several things: \\n\\u2022\\t A heavier load than designed for\\n\\u2022\\t Inadequate or incorrect lubrication\\n\\u2022\\t Ineffective bearing sealing\\n\\u2022\\t Shaft misalignment \\n\\u2022\\t Incorrect fit\\n\\u2022\\t Normal wear\\n\\u2022\\t Induced shaft voltages\\nOnce bearing failure begins, it also creates a cascade effect that \\naccelerates motor failure. 13\\u2006% of motor failures are caused by  \\nbearing failure, and more than 60\\u2006% of the mechanical failures  \\nin a facility are caused by bearing wear, so learning how to \\ntroubleshoot this potential problem is important. \\n\"}], \"id\": \"92dba63b8e4a27a6d92798ab\", \"layer\": \"source_claim\", \"object\": \"term_bearing_failure\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P6_B5\", \"quote\": \"Incorrect fit\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"failure_mode\", \"text\": \"bearing failure\"}, \"operating_conditions\": null, \"qualifier\": \"can\", \"relation\": \"CAUSES\", \"review_note\": \"\", \"subject\": {\"kind\": \"cause\", \"text\": \"incorrect fit\"}}, \"qualifier\": \"can\", \"relation\": \"CAUSES\", \"review\": {\"candidate_hash\": \"e99b0bbed22b2bd25145a11ee6ccd9ade67c32e4e6100c4b7f99e1016069a1c7\", \"candidate_id\": \"ATOM_0153036d6c027108276dbfc6\", \"decision\": \"accepted\", \"note\": \"Assistant verification only; human review pending. Page 6 P6_B5 explicitly introduces possible causes of bearing failure and lists incorrect fit. Full paragraph checked; retain can.\", \"reviewed_at\": \"2026-09-14T21:02:35.183913+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"c7f8842146507b286f377664\"}, \"run_id\": \"c7f8842146507b286f377664\", \"section\": \"10 Bearing wear\", \"section_id\": \"fault-10\", \"source_object\": \"556e1a8b7ae2513b1170a312\", \"source_subject\": \"86aad1538df734bbcd8d41f3\", \"subject\": \"source_86aad1538df734bbcd8d41f3\", \"topic\": \"topic_bearings\", \"warnings\": [\"endpoint_not_literal_in_quote_check_full_paragraph\", \"qualifier_not_literal_in_evidence\"]}" ;
