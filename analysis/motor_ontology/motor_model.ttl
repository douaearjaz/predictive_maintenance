    motor:metadataJSON "{\"applicability\": \"source_context_only\", \"candidate_id\": \"ATOM_595d774e487b88c8063caecf\", \"document_id\": \"DOC_cf0bdf9d28720ead73ea3680ce4f0d19dc8ff2f84bcf454378dea1215b51fa22\", \"document_name\": \"NP_7502_Electric Motor Predictive and Preventive Maintenance Guide.pdf\", \"evidence\": [{\"bbox\": [62.63999557495117, 426.9633483886719, 510.0133361816406, 463.6756591796875], \"clean_end\": 174, \"clean_start\": 103, \"document_id\": \"DOC_cf0bdf9d28720ead73ea3680ce4f0d19dc8ff2f84bcf454378dea1215b51fa22\", \"document_name\": \"NP_7502_Electric Motor Predictive and Preventive Maintenance Guide.pdf\", \"original_end\": 174, \"original_quote\": \"It can also cause loss of lubrication capability in bearing oil systems\", \"original_start\": 103, \"page\": 54, \"paragraph_id\": \"P54_B6\", \"quote\": \"It can also cause loss of lubrication capability in bearing oil systems\", \"section\": \"Moisture and motor insulation\", \"section_id\": \"epri-moisture\", \"source_paragraph_cleaned\": \"Excessive Moisture. Excessive moisture causes failures in motor winding insulation and in motor leads. It can also cause loss of lubrication capability in bearing oil systems and deterioration of motor parts, both electrical and mechanical.\", \"source_paragraph_original\": \"Excessive Moisture. Excessive moisture causes failures in motor winding insulation and\\nin motor leads. It can also cause loss of lubrication capability in bearing oil systems and\\ndeterioration of motor parts, both electrical and mechanical.\\n\"}], \"id\": \"e0852546b7fd02b69058da2a\", \"layer\": \"source_claim\", \"object\": \"source_402008eaa6cbcdff132aa53c\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P54_B6\", \"quote\": \"It can also cause loss of lubrication capability in bearing oil systems\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"failure_mode\", \"text\": \"loss of lubrication capability in bearing oil 