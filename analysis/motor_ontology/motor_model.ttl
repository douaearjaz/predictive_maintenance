    motor:metadataJSON "{\"applicability\": \"source_context_only\", \"candidate_id\": \"ATOM_1b0582193c63081ce1228aec\", \"document_id\": \"DOC_db0cb8fe8ba6918158759135579681f3ed396ae6472dfe2655462ca20fb5c583\", \"document_name\": \"ac-troubleshooting-guide.pdf\", \"evidence\": [{\"bbox\": [161.908203125, 370.08599853515625, 555.598388671875, 409.171142578125], \"clean_end\": 91, \"clean_start\": 65, \"document_id\": \"DOC_db0cb8fe8ba6918158759135579681f3ed396ae6472dfe2655462ca20fb5c583\", \"document_name\": \"ac-troubleshooting-guide.pdf\", \"original_end\": 93, \"original_quote\": \"The \\namps may also be high.\", \"original_start\": 66, \"page\": 3, \"paragraph_id\": \"P3_B9\", \"quote\": \"The amps may also be high.\", \"section\": \"Defective winding\", \"section_id\": \"ac-winding\", \"source_paragraph_cleaned\": \"Defective winding Test the winding for shorted or open circuits. The amps may also be high. For defective winding, replace the motor.\", \"source_paragraph_original\": \"Defective winding \\nTest the winding for shorted or open circuits. The \\namps may also be high. For defective winding, \\nreplace the motor. \\n\"}], \"id\": \"879d056732df0d3ce5456f8b\", \"layer\": \"source_claim\", \"object\": \"source_d6cf75e4dea9b30e5b785357\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P3_B9\", \"quote\": \"The amps may also be high.\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"symptom\", \"text\": \"high amps\"}, \"operating_conditions\": null, \"qualifier\": \"may be\", \"relation\": \"HAS_SYMPTOM\", \"review_note\": \"\", \"subject\": {\"kind\": \"failure_mode\", \"text\": \"Defective winding\"}}, \"qualifier\": \"may be\", \"relation\": \"HAS_SYMPTOM\", \"review\": {\"candidate_hash\": \"52662e83bfd0f04d00a775855e7fc1a9e945bc7ea7eb6e6d428316dd6fc8ab8e\", \"candidate_id\": \"ATOM_1b0582193c63081ce1228aec\", \"decision\": \"accepted\", \"note\": \"Source fidelity check only; technical approval pending. AC guide page 3 defective-winding paragraph says amps may also be high. Full paragraph checked; retain may.\", \"reviewed_at\": \"2026-09-15T00:14:45.704362+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"db43916284bc11e8e0ea9566\"}, \"run_id\": \"db43916284bc11e8e0ea9566\", \"section\": \"Defective winding\", \"section_id\": \"ac-winding\", \"source_object\": \"d6cf75e4dea9b30e5b785357\", \"source_subject\": \"9504802f0a8308fc6136062e\", \"subject\": \"source_9504802f0a8308fc6136062e\", \"topic\": \"topic_windings\", \"warnings\": [\"endpoint_not_literal_in_quote_check_full_paragraph\", \"qualifier_not_literal_in_evidence\"]}" ;
