    motor:metadataJSON "{\"applicability\": \"source_context_only\", \"candidate_id\": \"ATOM_a9795516872c711f58c22ebd\", \"document_id\": \"DOC_775874115de53f4ac9dfe96ef9fac58f3b2a9a0ae5697e5bff5c94110edaa6ec\", \"document_name\": \"Electric Motor Troubleshooting (Polyphase).pdf\", \"evidence\": [{\"bbox\": [63.25, 198.52781677246094, 225.35206604003906, 218.3039093017578], \"clean_end\": 48, \"clean_start\": 0, \"document_id\": \"DOC_775874115de53f4ac9dfe96ef9fac58f3b2a9a0ae5697e5bff5c94110edaa6ec\", \"document_name\": \"Electric Motor Troubleshooting (Polyphase).pdf\", \"original_end\": 48, \"original_quote\": \"Cause 2a: The motor controller will not\\noperate.\", \"original_start\": 0, \"page\": 6, \"paragraph_id\": \"P6_B24\", \"quote\": \"Cause 2a: The motor controller will not operate.\", \"section\": \"Starting: motor controller\", \"section_id\": \"lincoln-controller\", \"source_paragraph_cleaned\": \"Cause 2a: The motor controller will not operate.\", \"source_paragraph_original\": \"Cause 2a: The motor controller will not\\noperate.\\n\"}], \"id\": \"b217d2aebb649adaae0a5783\", \"layer\": \"source_claim\", \"object\": \"source_a73ef0e56675516129df2b70\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P6_B24\", \"quote\": \"Cause 2a: The motor controller will not operate.\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"failure_mode\", \"text\": \"will not operate\"}, \"operating_conditions\": null, \"qualifier\": \"asserted\", \"relation\": \"HAS_FAILURE_MODE\", \"review_note\": \"\", \"subject\": {\"kind\": \"component\", \"text\": \"motor controller\"}}, \"qualifier\": \"asserted\", \"relation\": \"HAS_FAILURE_MODE\", \"review\": {\"candidate_hash\": \"989a6db9600a47b1fb53aafc18e219b462ba781d0efebf60ecb00fd4fc79b4a7\", \"candidate_id\": \"ATOM_a9795516872c711f58c22ebd\", \"decision\": \"accepted\", \"note\": \"Source fidelity check only; technical approval pending. Lincoln physical page 6 Cause 2a explicitly identifies motor controller failure to operate. Component and failure state supported.\", \"reviewed_at\": \"2026-09-15T00:14:45.751777+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"12721e542a87b045002c420c\"}, \"run_id\": \"12721e542a87b045002c420c\", \"section\": \"Starting: motor controller\", \"section_id\": \"lincoln-controller\", \"source_object\": \"a73ef0e56675516129df2b70\", \"source_subject\": \"7710cb3b334ad892d7b904a4\", \"subject\": \"source_7710cb3b334ad892d7b904a4\", \"topic\": \"topic_starting\", \"warnings\": []}" ;
