    motor:metadataJSON "{\"applicability\": \"general_bearing_guidance_motor_applicability_pending\", \"candidate_id\": \"ATOM_dd944fb48c53ba6d62785103\", \"document_id\": \"DOC_eae8090d19d0478c75eda61af9c97af5953dc4395b339ef3c9806d9fa405e1ad\", \"document_name\": \"Manual_Udrzba_Montaz_TIMKEN_AJ.pdf\", \"evidence\": [{\"bbox\": [308.9988098144531, 208.98248291015625, 560.1505737304688, 259.74090576171875], \"clean_end\": 154, \"clean_start\": 0, \"document_id\": \"DOC_eae8090d19d0478c75eda61af9c97af5953dc4395b339ef3c9806d9fa405e1ad\", \"document_name\": \"Manual_Udrzba_Montaz_TIMKEN_AJ.pdf\", \"original_end\": 154, \"original_quote\": \"Small areas of damage on bearing races, and on the contact sur-\\nface of the rolling elements, can sometimes be repaired by grind-\\ning out the loose metal.\", \"original_start\": 0, \"page\": 12, \"paragraph_id\": \"P12_B5\", \"quote\": \"Small areas of damage on bearing races, and on the contact sur- face of the rolling elements, can sometimes be repaired by grind- ing out the loose metal.\", \"section\": \"Bearing repair\", \"section_id\": \"timken-repair\", \"source_paragraph_cleaned\": \"Small areas of damage on bearing races, and on the contact sur- face of the rolling elements, can sometimes be repaired by grind- ing out the loose metal. Any raised or rough areas should be smoothed flat with grinding and polishing tools.\", \"source_paragraph_original\": \"Small areas of damage on bearing races, and on the contact sur-\\nface of the rolling elements, can sometimes be repaired by grind-\\ning out the loose metal. Any raised or rough areas should be \\nsmoothed flat with grinding and polishing tools. \\n\"}], \"id\": \"45ef06d72df11496ae15ba8a\", \"layer\": \"source_claim\", \"object\": \"source_47693d0de47db914ab787e2f\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P12_B5\", \"quote\": \"Small areas of damage on bearing races, and on the contact sur- face of the rolling elements, can sometimes be repaired by grind- ing out the loose metal.\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"maintenance_action\", \"text\": \"grinding out the loose metal\"}, \"operating_conditions\": null, \"qualifier\": \"can sometimes\", \"relation\": \"MITIGATED_BY\", \"review_note\": \"\", \"subject\": {\"kind\": \"failure_mode\", \"text\": \"Small areas of damage on bearing races\"}}, \"qualifier\": \"can sometimes\", \"relation\": \"MITIGATED_BY\", \"review\": {\"candidate_hash\": \"c3472cc3f97e071544315fca81a8fafdd0f9b294d804e012090a58f273db12d1\", \"candidate_id\": \"ATOM_dd944fb48c53ba6d62785103\", \"decision\": \"accepted\", \"note\": \"Source fidelity check only; technical approval pending. Timken physical page 12 Bearing repair limits the recommendation to SMALL areas of damage on races and says can SOMETIMES. Subject and qualifier preserve these limits.\", \"reviewed_at\": \"2026-09-15T00:14:45.716346+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"b54ac34af4791ab118c217cf\"}, \"run_id\": \"b54ac34af4791ab118c217cf\", \"section\": \"Bearing repair\", \"section_id\": \"timken-repair\", \"source_object\": \"47693d0de47db914ab787e2f\", \"source_subject\": \"dc58294a27167c1ae20d17bd\", \"subject\": \"source_dc58294a27167c1ae20d17bd\", \"topic\": \"topic_bearings\", \"warnings\": [\"endpoint_not_literal_in_quote_check_full_paragraph\"]}" ;
