    motor:metadataJSON "{\"applicability\": \"source_context_only\", \"candidate_id\": \"ATOM_77175bb3fecfd4422d0f009a\", \"document_id\": \"DOC_90dca734e4b5699ff37901e18cdb90275e77ded8b355359130c493820d2fa913\", \"document_name\": \"3GZF500730-85 RevH_EN 06-2022_lowres.pdf\", \"evidence\": [{\"bbox\": [211.87811279296875, 534.7867431640625, 534.595703125, 543.3617553710938], \"clean_end\": 66, \"clean_start\": 18, \"document_id\": \"DOC_90dca734e4b5699ff37901e18cdb90275e77ded8b355359130c493820d2fa913\", \"document_name\": \"3GZF500730-85 RevH_EN 06-2022_lowres.pdf\", \"original_end\": 66, \"original_quote\": \"Change type or size. Consult equipment supplier.\", \"original_start\": 18, \"page\": 25, \"paragraph_id\": \"P25_B17\", \"quote\": \"Change type or size. Consult equipment supplier.\", \"section\": \"Motor stalls\", \"section_id\": \"abb-stalls\", \"source_paragraph_cleaned\": \"Wrong application Change type or size. Consult equipment supplier.\", \"source_paragraph_original\": \"Wrong application\\nChange type or size. Consult equipment supplier.\\n\"}], \"id\": \"69d87a8c0548bef8fc40249f\", \"layer\": \"source_claim\", \"object\": \"source_cf725aa305a577f763b0a07a\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P25_B17\", \"quote\": \"Change type or size. Consult equipment supplier.\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"maintenance_action\", \"text\": \"Change type or size. Consult equipment supplier.\"}, \"operating_conditions\": null, \"qualifier\": \"asserted\", \"relation\": \"MITIGATED_BY\", \"review_note\": \"\", \"subject\": {\"kind\": \"cause\", \"text\": \"Wrong application\"}}, \"qualifier\": \"asserted\", \"relation\": \"MITIGATED_BY\", \"review\": {\"candidate_hash\": \"b0f2a4de716373857f95fc13df7c8f36a0c121a53257d3805830579dc7d87be5\", \"candidate_id\": \"ATOM_77175bb3fecfd4422d0f009a\", \"decision\": \"accepted\", \"note\": \"Source fidelity check only; technical approval pending. ABB Wrong application row recommends changing type/size and consulting supplier. Matched that row only.\", \"reviewed_at\": \"2026-09-15T00:14:45.683336+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"2cc983acb246bd929a89ac82\"}, \"run_id\": \"2cc983acb246bd929a89ac82\", \"section\": \"Motor stalls\", \"section_id\": \"abb-stalls\", \"source_object\": \"cf725aa305a577f763b0a07a\", \"source_subject\": \"3490190e3e31927e2ca54b84\", \"subject\": \"source_3490190e3e31927e2ca54b84\", \"topic\": \"topic_stalling\", \"warnings\": [\"endpoint_not_literal_in_quote_check_full_paragraph\"]}" ;
