r leads\"}, \"operating_conditions\": null, \"qualifier\": \"causes\", \"relation\": \"CAUSES\", \"review_note\": \"\", \"subject\": {\"kind\": \"phenomenon\", \"text\": \"excessive moisture\"}}, \"qualifier\": \"causes\", \"relation\": \"CAUSES\", \"review\": {\"candidate_hash\": \"ac5ed8bb81c8675e171cfa87a62c31428a2fb64f5e937b27287ea28babf491ca\", \"candidate_id\": \"ATOM_30da26e247cbbc27a8e62e54\", \"decision\": \"accepted\", \"note\": \"Source fidelity check only; technical approval pending. EPRI same sentence explicitly includes motor lead failures as a separate effect of excessive moisture.\", \"reviewed_at\": \"2026-09-15T00:14:45.790357+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"fbbf87da083d3d923af71181\"}, \"run_id\": \"fbbf87da083d3d923af71181\", \"section\": \"Moisture and motor insulation\", \"section_id\": \"epri-moisture\", \"source_object\": \"c8743c0c91c18f54aee193d0\", \"source_subject\": \"8d39968b9dde89d029336004\", \"subject\": \"source_8d39968b9dde89d029336004\", \"topic\": \"topic_moisture\", \"warnings\": [\"endpoint_not_literal_in_quote_check_full_paragraph\"]}" ;
