ut circuit single phased\"}}, \"qualifier\": \"could have been a temporary condition\", \"relation\": \"CAUSES\", \"review\": {\"candidate_hash\": \"8ec19341c8bacb10fd460b9210a91ddff548e7c4603601c8d778c4e0b3ab85f3\", \"candidate_id\": \"ATOM_f016bbaefd26a4ffd01b0a1b\", \"decision\": \"accepted\", \"note\": \"Source fidelity check only; technical approval pending. Lincoln Trouble 3 and Cause 3a are a numbered pair. Missing voltage in one/two phases is listed for motor not starting with hum/heating. Preserve the possible temporary-condition qualifier.\", \"reviewed_at\": \"2026-09-15T00:14:45.756310+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"12721e542a87b045002c420c\"}, \"run_id\": \"12721e542a87b045002c420c\", \"section\": \"Motor will not start; hums and heats\", \"section_id\": \"lincoln-hums\", \"source_object\": \"3cc2a0b591dddf9cd567c7be\", \"source_subject\": \"bf3e979efbc4ecaaf9dc9663\", \"subject\": \"source_bf3e979efbc4ecaaf9dc9663\", \"topic\": \"topic_starting\", \"warnings\": [\"endpoint_not_literal_in_quote_check_full_paragraph\"]}" ;
