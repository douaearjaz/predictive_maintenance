motor:claim_460c37681cdef41b06522875 a rdf:Statement ;
    rdf:object motor:term_bearing_failure ;
    rdf:predicate motor:CAUSES ;
    rdf:subject motor:term_shaft_misalignment ;
    motor:metadataJSON "{\"applicability\": \"source_context_only\", \"candidate_id\": \"ATOM_fca9a4e8e9397c8c68d9b264\", \"document_id\": \"DOC_bc4bdf2b43eb7832b16dfab1668af3e742a93a1cb1dbfd36ba2b901d5af6a371\", \"document_name\": \"13-common-causes.pdf\", \"evidence\": [{\"bbox\": [268.7143249511719, 393.11505126953125, 542.9324951171875, 576.4556274414062], \"clean_end\": 306, \"clean_start\": 288, \"document_id\": \"DOC_bc4bdf2b43eb7832b16dfab1668af3e742a93a1cb1dbfd36ba2b901d5af6a371\", \"document_name\": \"13-common-causes.pdf\", \"original_end\": 314, \"original_quote\": \"Shaft misalignment\", \"original_start\": 296, \"page\": 6, \"paragraph_id\": \"P6_B5\", \"quote\": \"Shaft misalignment\", \"section\": \"10 Bearing wear\", \"section_id\": \"fault-10\", \"source_paragraph_cleaned\": \"A failed bearing has increased drag, emits more heat, and has lower efficiency because of a mechanical, lubrication, or wear problem. Bearing failure can be caused by several things: \\u2022 A heavier load than designed for \\u2022 Inadequate or incorrect lubrication \\u2022 Ineffective bearing sealing \\u2022 Shaft misalignment \\u2022 Incorrect fit \\u2022 Normal wear \\u2022 Induced shaft voltages Once bearing failure begins, it also creates a cascade effect that accelerates motor failure. 13 % of motor failures are caused by bearing failure, and more than 60 % of the mechanical failures in a facility are caused by bearing wear, so learning how to troubleshoot this potential problem is important.\", \"source_paragraph_original\": \"A failed bearing has increased drag, emits more heat, and has \\nlower efficiency because of a mechanical, lubrication, or wear  \\nproblem. Bearing failure can be caused by several things: \\n\\u2022\\t A heavier load than designed for\\n\\u2022\\t Inadequate or incorrect lubrication\\n\\u2022\\t Ineffective bearing sealing\\n\\u2022\\t Shaft misalignment \\n\\u2022\\t Incorrect fit\\n\\u2022\\t Normal wear\\n\\u2022\\t Induced shaft voltages\\nOnce bearing failure begins, it also creates a cascade effect that \\naccelerates motor failure. 13\\u2006% of motor failures are caused by  \\nbearing failure, and more than 60\\u2006% of the mechanical failures  \\nin a facility are caused by bearing wear, so learning how to \\ntroubleshoot this potential problem is important. \\n\"}], \"id\": \"460c37681cdef41b06522875\", \"layer\": \"source_claim\", \"object\": \"term_bearing_failure\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P6_B5\", \"quote\": \"Shaft misalignment\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"failure_mode\", \"text\": \"bearing failure\"}, \"operating_conditions\": null, \"qualifier\": \"can\", \"relation\": \"CAUSES\", \"review_note\": \"\", \"subject\": {\"kind\": \"cause\", \"text\": \"shaft misalignment\"}}, \"qualifier\": \"can\", \"relation\": \"CAUSES\", \"review\": {\"candidate_hash\": \"ee30ebfe24d40badf45c52d274d18469f4fa4d30f48f7324b262f48939104cc2\", \"candidate_id\": \"ATOM_fca9a4e8e9397c8c68d9b264\", \"decision\": \"accepted\", \"note\": \"Assistant verification only; human review pending. Page 6 P6_B5 explicitly introduces possible causes of bearing failure and lists shaft misalignment. Full paragraph checked; retain can.\", \"reviewed_at\": \"2026-09-14T21:02:35.148146+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"c7f8842146507b286f377664\"}, \"run_id\": \"c7f8842146507b286f377664\", \"section\": \"10 Bearing wear\", \"section_id\": \"fault-10\", \"source_object\": \"556e1a8b7ae2513b1170a312\", \"source_subject\": \"2d8667dab11c25d963c8f5ea\", \"subject\": \"term_shaft_misalignment\", \"topic\": \"topic_bearings\", \"warnings\": [\"endpoint_not_literal_in_quote_check_full_paragraph\", \"qualifier_not_literal_in_evidence\"]}" ;
    motor:qualifier "can" .

motor:claim_5016c53b511cb60a4a1f18d0 a rdf:Statement ;
    rdf:object motor:source_8480d55b5b850349a49e2dd6 ;
    rdf:predicate motor:DETECTED_BY ;
    rdf:subject motor:source_648428e782a7bc678f1d77ac ;
    motor:metadataJSON "{\"applicability\": \"source_context_only\", \"candidate_id\": \"ATOM_0535a0cb0182be1d547bc08e\", \"document_id\": \"DOC_cf0bdf9d28720ead73ea3680ce4f0d19dc8ff2f84bcf454378dea1215b51fa22\", \"document_name\": \"NP_7502_Electric Motor Predictive and Preventive Maintenance Guide.pdf\", \"evidence\": [{\"bbox\": [62.63999938964844, 261.6031188964844, 511.3307189941406, 361.1955261230469], \"clean_end\": 573, \"clean_start\": 494, \"document_id\": \"DOC_cf0bdf9d28720ead73ea3680ce4f0d19dc8ff2f84bcf454378dea1215b51fa22\", \"document_name\": \"NP_7502_Electric Motor Predictive and Preventive Maintenance Guide.pdf\", \"original_end\": 573, \"original_quote\": \"Indication of a wet winding\\ncan often be found by insulation resistance testing\", \"original_start\": 494, \"page\": 54, \"paragraph_id\": \"P54_B4\", \"quote\": \"Indication of a wet winding can often be found by insulation resistance testing\", \"section\": \"Moisture and motor insulation\", \"section_id\": \"epri-moisture\", \"source_paragraph_cleaned\": \"Protecting the motor winding from moisture is a major concern. When the motor is in use, condensation is usually not a problem. However when idle, the motor winding needs to be kept dry (i.e. heaters). If there is any moisture in the groundwall insulation of the winding, it should not be energized since this could cause gross failure of the wind- ng. Often a wet winding can be dried out by applying external heat or by circulating low level DC current through the windings (Reference 6.12). Indication of a wet winding can often be found by insulation resistance testing. Additional discussion on causes of failures are as follows:\", \"source_paragraph_original\": \"Protecting the motor winding from moisture is a major concern. When the motor is in\\nuse, condensation is usually not a problem. However when idle, the motor winding\\nneeds to be kept dry (i.e. heaters). If there is any moisture in the groundwall insulation\\nof the winding, it should not be energized since this could cause gross failure of the wind-\\nng. Often a wet winding can be dried out by applying external heat or by circulating\\nlow level DC current through the windings (Reference 6.12). Indication of a wet winding\\ncan often be found by insulation resistance testing. Additional discussion on causes of\\nfailures are as follows:\\n\"}], \"id\": \"5016c53b511cb60a4a1f18d0\", \"layer\": \"source_claim\", \"object\": \"source_8480d55b5b850349a49e2dd6\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P54_B4\", \"quote\": \"Indication of a wet winding can often be found by insulation resistance testing\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"detection_method\", \"text\": \"insulation resistance testing\"}, \"operating_conditions\": null, \"qualifier\": \"can often be found by\", \"relation\": \"DETECTED_BY\", \"review_note\": \"\", \"subject\": {\"kind\": \"failure_mode\", \"text\": \"wet winding\"}}, \"qualifier\": \"can often be found by\", \"relation\": \"DETECTED_BY\", \"review\": {\"candidate_hash\": \"b31ceeff9af46307c0a3f01b34329c8a5c70661cd24e80bc81f1f1bca3d5d59c\", \"candidate_id\": \"ATOM_0535a0cb0182be1d547bc08e\", \"decision\": \"accepted\", \"note\": \"Source fidelity check only; technical approval pending. EPRI physical page 54 moisture paragraph explicitly states insulation resistance testing can often indicate a wet winding. Qualifier can often retained.\", \"reviewed_at\": \"2026-09-15T00:14:45.776777+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"fbbf87da083d3d923af71181\"}, \"run_id\": \"fbbf87da083d3d923af71181\", \"section\": \"Moisture and motor insulation\", \"section_id\": \"epri-moisture\", \"source_object\": \"8480d55b5b850349a49e2dd6\", \"source_subject\": \"648428e782a7bc678f1d77ac\", \"subject\": \"source_648428e782a7bc678f1d77ac\", \"topic\": \"topic_moisture\", \"warnings\": []}" ;
    motor:qualifier "can often be found by" .

