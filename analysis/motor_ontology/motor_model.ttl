motor:claim_ef3bb596bb010d21ca03efa6 a rdf:Statement ;
    rdf:object motor:source_5221e2d07843aa058c4941ac ;
    rdf:predicate motor:HAS_SYMPTOM ;
    rdf:subject motor:term_bearing_failure ;
    motor:metadataJSON "{\"applicability\": \"source_context_only\", \"candidate_id\": \"ATOM_efdd526554c2c30dfa54cc1b\", \"document_id\": \"DOC_bc4bdf2b43eb7832b16dfab1668af3e742a93a1cb1dbfd36ba2b901d5af6a371\", \"document_name\": \"13-common-causes.pdf\", \"evidence\": [{\"bbox\": [268.7143249511719, 393.11505126953125, 542.9324951171875, 576.4556274414062], \"clean_end\": 52, \"clean_start\": 37, \"document_id\": \"DOC_bc4bdf2b43eb7832b16dfab1668af3e742a93a1cb1dbfd36ba2b901d5af6a371\", \"document_name\": \"13-common-causes.pdf\", \"original_end\": 52, \"original_quote\": \"emits more heat\", \"original_start\": 37, \"page\": 6, \"paragraph_id\": \"P6_B5\", \"quote\": \"emits more heat\", \"section\": \"10 Bearing wear\", \"section_id\": \"fault-10\", \"source_paragraph_cleaned\": \"A failed bearing has increased drag, emits more heat, and has lower efficiency because of a mechanical, lubrication, or wear problem. Bearing failure can be caused by several things: \\u2022 A heavier load than designed for \\u2022 Inadequate or incorrect lubrication \\u2022 Ineffective bearing sealing \\u2022 Shaft misalignment \\u2022 Incorrect fit \\u2022 Normal wear \\u2022 Induced shaft voltages Once bearing failure begins, it also creates a cascade effect that accelerates motor failure. 13 % of motor failures are caused by bearing failure, and more than 60 % of the mechanical failures in a facility are caused by bearing wear, so learning how to troubleshoot this potential problem is important.\", \"source_paragraph_original\": \"A failed bearing has increased drag, emits more heat, and has \\nlower efficiency because of a mechanical, lubrication, or wear  \\nproblem. Bearing failure can be caused by several things: \\n\\u2022\\t A heavier load than designed for\\n\\u2022\\t Inadequate or incorrect lubrication\\n\\u2022\\t Ineffective bearing sealing\\n\\u2022\\t Shaft misalignment \\n\\u2022\\t Incorrect fit\\n\\u2022\\t Normal wear\\n\\u2022\\t Induced shaft voltages\\nOnce bearing failure begins, it also creates a cascade effect that \\naccelerates motor failure. 13\\u2006% of motor failures are caused by  \\nbearing failure, and more than 60\\u2006% of the mechanical failures  \\nin a facility are caused by bearing wear, so learning how to \\ntroubleshoot this potential problem is important. \\n\"}], \"id\": \"ef3bb596bb010d21ca03efa6\", \"layer\": \"source_claim\", \"object\": \"source_5221e2d07843aa058c4941ac\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P6_B5\", \"quote\": \"emits more heat\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"symptom\", \"text\": \"emits more heat\"}, \"operating_conditions\": null, \"qualifier\": \"asserted\", \"relation\": \"HAS_SYMPTOM\", \"review_note\": \"\", \"subject\": {\"kind\": \"failure_mode\", \"text\": \"failed bearing\"}}, \"qualifier\": \"asserted\", \"relation\": \"HAS_SYMPTOM\", \"review\": {\"candidate_hash\": \"bc8dd8fd40a8da757b3818d7fabcdb9f9e0584793cb46cd612c196f4e0513277\", \"candidate_id\": \"ATOM_efdd526554c2c30dfa54cc1b\", \"decision\": \"accepted\", \"note\": \"Assistant verification only; human review pending. Page 6 opening sentence states a failed bearing emits more heat. Full P6_B5 paragraph resolves the subject omitted from the short quote.\", \"reviewed_at\": \"2026-09-14T21:02:35.292812+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"c7f8842146507b286f377664\"}, \"run_id\": \"c7f8842146507b286f377664\", \"section\": \"10 Bearing wear\", \"section_id\": \"fault-10\", \"source_object\": \"5221e2d07843aa058c4941ac\", \"source_subject\": \"556e1a8b7ae2513b1170a312\", \"subject\": \"term_bearing_failure\", \"topic\": \"topic_bearings\", \"warnings\": [\"endpoint_not_literal_in_quote_check_full_paragraph\"]}" ;
