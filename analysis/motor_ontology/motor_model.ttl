    rdf:subject motor:source_f7c6126ce1549ee6d26a7f11 ;
    motor:metadataJSON "{\"applicability\": \"source_context_only\", \"candidate_id\": \"ATOM_e9e3622f927de365887e6d11\", \"document_id\": \"DOC_775874115de53f4ac9dfe96ef9fac58f3b2a9a0ae5697e5bff5c94110edaa6ec\", \"document_name\": \"Electric Motor Troubleshooting (Polyphase).pdf\", \"evidence\": [{\"bbox\": [262.0, 563.8579711914062, 540.30029296875, 603.6337890625], \"clean_end\": 231, \"clean_start\": 0, \"document_id\": \"DOC_775874115de53f4ac9dfe96ef9fac58f3b2a9a0ae5697e5bff5c94110edaa6ec\", \"document_name\": \"Electric Motor Troubleshooting (Polyphase).pdf\", \"original_end\": 231, \"original_quote\": \"Cure 3b: Replace the motor. ALWAYS have an expert check the\\nmotor windings to determine whether the single phasing occurred in\\nthe input circuit or in the motor windings. If in the input circuit, correct\\nthe single phase condition.\", \"original_start\": 0, \"page\": 6, \"paragraph_id\": \"P6_B10\", \"quote\": \"Cure 3b: Replace the motor. ALWAYS have an expert check the motor windings to determine whether the single phasing occurred in the input circuit or in the motor windings. If in the input circuit, correct the single phase condition.\", \"section\": \"Motor will not start; hums and heats\", \"section_id\": \"lincoln-hums\", \"source_paragraph_cleaned\": \"Cure 3b: Replace the motor. ALWAYS have an expert check the motor windings to determine whether the single phasing occurred in the input circuit or in the motor windings. If in the input circuit, correct the single phase condition.\", \"source_paragraph_original\": \"Cure 3b: Replace the motor. ALWAYS have an expert check the\\nmotor windings to determine whether the single phasing occurred in\\nthe input circuit or in the motor windings. If in the input circuit, correct\\nthe single phase condition.\\n\"}], \"id\": \"8776ca91fd131c77d3bea2c1\", \"layer\": \"source_claim\", \"object\": \"source_33f35ba35a9c657175043ef9\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P6_B10\", \"quote\": \"Cure 3b: Replace the motor. ALWAYS have an expert check the motor windings to determine whether the single phasing occurred in the input circuit or in the motor windings. If in the input circuit, correct the single phase condition.\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"maintenance_action\", \"text\": \"expert check the motor windings to determine whether the single phasing occurred in the input circuit or in the motor windings\"}, \"operating_conditions\": null, \"qualifier\": \"asserted\", \"relation\": \"MITIGATED_BY\", \"review_note\": \"\", \"subject\": {\"kind\": \"cause\", \"text\": \"Motor was single phased\"}}, \"qualifier\": \"asserted\", \"relation\": \"MITIGATED_BY\", \"review\": {\"candidate_hash\": \"96a10d71e7ee7ce6b9f4f378f79cf565376615096596ca180715d310233213b4\", \"candidate_id\": \"ATOM_e9e3622f927de365887e6d11\", \"decision\": \"accepted\", \"note\": \"Source fidelity check only; technical approval pending. Lincoln Cure 3b explicitly requires expert winding examination to distinguish input-circuit versus winding single-phasing. This diagnostic investigation stays with Cause 3b.\", \"reviewed_at\": \"2026-09-15T00:14:45.771436+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"12721e542a87b045002c420c\"}, \"run_id\": \"12721e542a87b045002c420c\", \"section\": \"Motor will not start; hums and heats\", \"section_id\": \"lincoln-hums\", \"source_object\": \"33f35ba35a9c657175043ef9\", \"source_subject\": \"f7c6126ce1549ee6d26a7f11\", \"subject\": \"source_f7c6126ce1549ee6d26a7f11\", \"topic\": \"topic_starting\", \"warnings\": [\"endpoint_not_literal_in_quote_check_full_paragraph\"]}" ;
