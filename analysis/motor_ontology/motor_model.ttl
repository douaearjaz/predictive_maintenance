    motor:metadataJSON "{\"applicability\": \"general_bearing_guidance_motor_applicability_pending\", \"candidate_id\": \"ATOM_360127dc050b6c470eb1f110\", \"document_id\": \"DOC_eae8090d19d0478c75eda61af9c97af5953dc4395b339ef3c9806d9fa405e1ad\", \"document_name\": \"Manual_Udrzba_Montaz_TIMKEN_AJ.pdf\", \"evidence\": [{\"bbox\": [308.9988098144531, 208.98248291015625, 560.1505737304688, 259.74090576171875], \"clean_end\": 239, \"clean_start\": 155, \"document_id\": \"DOC_eae8090d19d0478c75eda61af9c97af5953dc4395b339ef3c9806d9fa405e1ad\", \"document_name\": \"Manual_Udrzba_Montaz_TIMKEN_AJ.pdf\", \"original_end\": 240, \"original_quote\": \"Any raised or rough areas should be \\nsmoothed flat with grinding and polishing tools.\", \"original_start\": 155, \"page\": 12, \"paragraph_id\": \"P12_B5\", \"quote\": \"Any raised or rough areas should be smoothed flat with grinding and polishing tools.\", \"section\": \"Bearing repair\", \"section_id\": \"timken-repair\", \"source_paragraph_cleaned\": \"Small areas of damage on bearing races, and on the contact sur- face of the rolling elements, can sometimes be repaired by grind- ing out the loose metal. Any raised or rough areas should be smoothed flat with grinding and polishing tools.\", \"source_paragraph_original\": \"Small areas of damage on bearing races, and on the contact sur-\\nface of the rolling elements, can sometimes be repaired by grind-\\ning out the loose metal. Any raised or rough areas should be \\nsmoothed flat with grinding and polishing tools. \\n\"}], \"id\": \"1423d0554b8646be031e59f1\", \"layer\": \"source_claim\", \"object\": \"source_b7731043241207638590e5d6\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P12_B5\", \"quote\": \"Any raised or rough areas should be smoothed flat with grinding and polishing tools.\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"maintenance_action\", \"text\": \"smoothing flat with grinding and polishing tools\"}, \"operating_conditions\": null, \"qualifier\": \"should\", \"relation\": \"MITIGATED_BY\", \"review_note\": \"\", \"subject\": {\"kind\": \"failure_mode\", \"text\": \"raised or rough areas\"}}, \"qualifier\": \"should\", \"relation\": \"MITIGATED_BY\", \"review\": {\"candidate_hash\": \"c63fa12059d7df5aa5eb434d80ded6878efb4ddfec7fd3973d83f743b23ffd01\", \"candidate_id\": \"ATOM_360127dc050b6c470eb1f110\", \"decision\": \"accepted\", \"note\": \"Source fidelity check only; technical approval pending. Timken Bearing repair explicitly recommends smoothing raised/rough areas with grinding and polishing tools; keep should.\", \"reviewed_at\": \"2026-09-15T00:14:45.726358+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"b54ac34af4791ab118c217cf\"}, \"run_id\": \"b54ac34af4791ab118c217cf\", \"section\": \"Bearing repair\", \"section_id\": \"timken-repair\", \"source_object\": \"b7731043241207638590e5d6\", \"source_subject\": \"9b33abda30f68a42a8891f3d\", \"subject\": \"source_9b33abda30f68a42a8891f3d\", \"topic\": \"topic_bearings\", \"warnings\": [\"endpoint_not_literal_in_quote_check_full_paragraph\"]}" ;
