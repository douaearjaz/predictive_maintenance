motor:claim_8ef941de8d420caee50fb72d a rdf:Statement ;
    rdf:object motor:source_fe781bcd2e0ed65ffd9b28c3 ;
    rdf:predicate motor:HAS_SYMPTOM ;
    rdf:subject motor:term_bearing_failure ;
    motor:metadataJSON "{\"applicability\": \"source_context_only\", \"candidate_id\": \"ATOM_e9a5a736ae89891d593e3a35\", \"document_id\": \"DOC_bc4bdf2b43eb7832b16dfab1668af3e742a93a1cb1dbfd36ba2b901d5af6a371\", \"document_name\": \"13-common-causes.pdf\", \"evidence\": [{\"bbox\": [268.7143249511719, 393.11505126953125, 542.9324951171875, 576.4556274414062], \"clean_end\": 35, \"clean_start\": 0, \"document_id\": \"DOC_bc4bdf2b43eb7832b16dfab1668af3e742a93a1cb1dbfd36ba2b901d5af6a371\", \"document_name\": \"13-common-causes.pdf\", \"original_end\": 35, \"original_quote\": \"A failed bearing has increased drag\", \"original_start\": 0, \"page\": 6, \"paragraph_id\": \"P6_B5\", \"quote\": \"A failed bearing has increased drag\", \"section\": \"10 Bearing wear\", \"section_id\": \"fault-10\", \"source_paragraph_cleaned\": \"A failed bearing has increased drag, emits more heat, and has lower efficiency because of a mechanical, lubrication, or wear problem. Bearing failure can be caused by several things: \\u2022 A heavier load than designed for \\u2022 Inadequate or incorrect lubrication \\u2022 Ineffective bearing sealing \\u2022 Shaft misalignment \\u2022 Incorrect fit \\u2022 Normal wear \\u2022 Induced shaft voltages Once bearing failure begins, it also creates a cascade effect that accelerates motor failure. 13 % of motor failures are caused by bearing failure, and more than 60 % of the mechanical failures in a facility are caused by bearing wear, so learning how to troubleshoot this potential problem is important.\", \"source_paragraph_original\": \"A failed bearing has increased drag, emits more heat, and has \\nlower efficiency because of a mechanical, lubrication, or wear  \\nproblem. Bearing failure can be caused by several things: \\n\\u2022\\t A heavier load than designed for\\n\\u2022\\t Inadequate or incorrect lubrication\\n\\u2022\\t Ineffective bearing sealing\\n\\u2022\\t Shaft misalignment \\n\\u2022\\t Incorrect fit\\n\\u2022\\t Normal wear\\n\\u2022\\t Induced shaft voltages\\nOnce bearing failure begins, it also creates a cascade effect that \\naccelerates motor failure. 13\\u2006% of motor failures are caused by  \\nbearing failure, and more than 60\\u2006% of the mechanical failures  \\nin a facility are caused by bearing wear, so learning how to \\ntroubleshoot this potential problem is important. \\n\"}], \"id\": \"8ef941de8d420caee50fb72d\", \"layer\": \"source_claim\", \"object\": \"source_fe781bcd2e0ed65ffd9b28c3\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P6_B5\", \"quote\": \"A failed bearing has increased drag\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"symptom\", \"text\": \"increased drag\"}, \"operating_conditions\": null, \"qualifier\": \"asserted\", \"relation\": \"HAS_SYMPTOM\", \"review_note\": \"\", \"subject\": {\"kind\": \"failure_mode\", \"text\": \"failed bearing\"}}, \"qualifier\": \"asserted\", \"relation\": \"HAS_SYMPTOM\", \"review\": {\"candidate_hash\": \"62a5091d2a59a1726a57e6e7920ad47343bf2569f0810c28c15eec11756972ad\", \"candidate_id\": \"ATOM_e9a5a736ae89891d593e3a35\", \"decision\": \"accepted\", \"note\": \"Assistant verification only; human review pending. Page 6 opening sentence states a failed bearing has increased drag. This is an observed symptom, not an upstream cause.\", \"reviewed_at\": \"2026-09-14T21:02:35.269140+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"c7f8842146507b286f377664\"}, \"run_id\": \"c7f8842146507b286f377664\", \"section\": \"10 Bearing wear\", \"section_id\": \"fault-10\", \"source_object\": \"fe781bcd2e0ed65ffd9b28c3\", \"source_subject\": \"556e1a8b7ae2513b1170a312\", \"subject\": \"term_bearing_failure\", \"topic\": \"topic_bearings\", \"warnings\": []}" ;
    motor:qualifier "asserted" .

