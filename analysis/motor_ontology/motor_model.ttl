    motor:metadataJSON "{\"applicability\": \"general_bearing_guidance_motor_applicability_pending\", \"candidate_id\": \"ATOM_9703975396b62ed6201b3224\", \"document_id\": \"DOC_eae8090d19d0478c75eda61af9c97af5953dc4395b339ef3c9806d9fa405e1ad\", \"document_name\": \"Manual_Udrzba_Montaz_TIMKEN_AJ.pdf\", \"evidence\": [{\"bbox\": [41.99760055541992, 601.0715942382812, 293.1300964355469, 690.818115234375], \"clean_end\": 109, \"clean_start\": 80, \"document_id\": \"DOC_eae8090d19d0478c75eda61af9c97af5953dc4395b339ef3c9806d9fa405e1ad\", \"document_name\": \"Manual_Udrzba_Montaz_TIMKEN_AJ.pdf\", \"original_end\": 109, \"original_quote\": \"improper storage and handling\", \"original_start\": 80, \"page\": 12, \"paragraph_id\": \"P12_B24\", \"quote\": \"improper storage and handling\", \"section\": \"Damaged bearings\", \"section_id\": \"timken-damage\", \"source_paragraph_cleaned\": \"Despite taking proper precautions, bearings may become dam- aged either through improper storage and handling or through normal wear in use. Bearings that have been damaged or are no longer within specifications may still be returned to service after repair or refurbishment. Some bearings can be refurbished more than once. Eventually all bearings will sustain sufficient wear or damage and will have to be replaced.\", \"source_paragraph_original\": \"Despite taking proper precautions, bearings may become dam-\\naged either through improper storage and handling or through \\nnormal wear in use. Bearings that have been damaged or are no \\nlonger within specifications may still be returned to service after \\nrepair or refurbishment. Some bearings can be refurbished more \\nthan once. Eventually all bearings will sustain sufficient wear or \\ndamage and will have to be replaced.\\n\"}], \"id\": \"68509b8634576631f4bf1797\", \"layer\": \"source_claim\", \"object\": \"source_3a8d8364b4f2a04eede7a21b\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P12_B24\", \"quote\": \"improper storage and handling\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"failure_mode\", \"text\": \"damaged bearing\"}, \"operating_conditions\": null, \"qualifier\": \"may\", \"relation\": \"CAUSES\", \"review_note\": \"\", \"subject\": {\"kind\": \"cause\", \"text\": \"improper storage and handling\"}}, \"qualifier\": \"may\", \"relation\": \"CAUSES\", \"review\": {\"candidate_hash\": \"fe2ece044f67be62c9cbf8249d003ea7f123b0d4b594194328bc2eceba0b25f4\", \"candidate_id\": \"ATOM_9703975396b62ed6201b3224\", \"decision\": \"accepted\", \"note\": \"Source fidelity check only; technical approval pending. Timken Damaged bearings paragraph says bearings may become damaged through improper storage and handling. Full paragraph resolves the shortened quotation; preserve may.\", \"reviewed_at\": \"2026-09-15T00:14:45.735476+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"b54ac34af4791ab118c217cf\"}, \"run_id\": \"b54ac34af4791ab118c217cf\", \"section\": \"Damaged bearings\", \"section_id\": \"timken-damage\", \"source_object\": \"3a8d8364b4f2a04eede7a21b\", \"source_subject\": \"5e332f87af38c91b6ec3f6cb\", \"subject\": \"source_5e332f87af38c91b6ec3f6cb\", \"topic\": \"topic_bearings\", \"warnings\": [\"endpoint_not_literal_in_quote_check_full_paragraph\", \"qualifier_not_literal_in_evidence\"]}" ;
