    motor:metadataJSON "{\"applicability\": \"source_context_only\", \"candidate_id\": \"ATOM_5c6fece6bc806d9843d9d6b4\", \"document_id\": \"DOC_db0cb8fe8ba6918158759135579681f3ed396ae6472dfe2655462ca20fb5c583\", \"document_name\": \"ac-troubleshooting-guide.pdf\", \"evidence\": [{\"bbox\": [319.6659851074219, 453.2501220703125, 559.1820068359375, 492.3273620605469], \"clean_end\": 142, \"clean_start\": 86, \"document_id\": \"DOC_db0cb8fe8ba6918158759135579681f3ed396ae6472dfe2655462ca20fb5c583\", \"document_name\": \"ac-troubleshooting-guide.pdf\", \"original_end\": 144, \"original_quote\": \"An unbalanced \\nload will also cause the bearings to fail.\", \"original_start\": 87, \"page\": 3, \"paragraph_id\": \"P3_B12\", \"quote\": \"An unbalanced load will also cause the bearings to fail.\", \"section\": \"Unbalanced load and bearing failure\", \"section_id\": \"ac-unbalanced-load\", \"source_paragraph_cleaned\": \"Check the motor load and inspect the drive belt tension to ensure it\\u2019s not too tight. An unbalanced load will also cause the bearings to fail.\", \"source_paragraph_original\": \"Check the motor load and inspect the drive belt \\ntension to ensure it\\u2019s not too tight. An unbalanced \\nload will also cause the bearings to fail. \\n\"}], \"id\": \"ee099c73dbeacfb05d4a46a8\", \"layer\": \"source_claim\", \"object\": \"term_bearing_failure\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P3_B12\", \"quote\": \"An unbalanced load will also cause the bearings to fail.\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"failure_mode\", \"text\": \"bearings to fail\"}, \"operating_conditions\": null, \"qualifier\": \"will also\", \"relation\": \"CAUSES\", \"review_note\": \"\", \"subject\": {\"kind\": \"phenomenon\", \"text\": \"unbalanced load\"}}, \"qualifier\": \"will also\", \"relation\": \"CAUSES\", \"review\": {\"candidate_hash\": \"09a0493e79b353073357b2c73f2df9c2aa50ad0bfe42e0d8e5fc68a29a90f625\", \"candidate_id\": \"ATOM_5c6fece6bc806d9843d9d6b4\", \"decision\": \"accepted\", \"note\": \"Source fidelity check only; technical approval pending. AC guide page 3 explicitly states an unbalanced load will also cause the bearings to fail. No missing first-column table heading was inferred.\", \"reviewed_at\": \"2026-09-15T00:14:45.711142+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"db43916284bc11e8e0ea9566\"}, \"run_id\": \"db43916284bc11e8e0ea9566\", \"section\": \"Unbalanced load and bearing failure\", \"section_id\": \"ac-unbalanced-load\", \"source_object\": \"7e668ed33832a948ca569436\", \"source_subject\": \"66e3b668db13f94996c75e1d\", \"subject\": \"source_66e3b668db13f94996c75e1d\", \"topic\": \"topic_bearings\", \"warnings\": []}" ;
