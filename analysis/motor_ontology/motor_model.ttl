    motor:metadataJSON "{\"applicability\": \"source_context_only\", \"candidate_id\": \"ATOM_4cb87335d85843e10127ee8a\", \"document_id\": \"DOC_775874115de53f4ac9dfe96ef9fac58f3b2a9a0ae5697e5bff5c94110edaa6ec\", \"document_name\": \"Electric Motor Troubleshooting (Polyphase).pdf\", \"evidence\": [{\"bbox\": [64.24980163574219, 563.8579711914062, 230.39425659179688, 593.6339111328125], \"clean_end\": 105, \"clean_start\": 0, \"document_id\": \"DOC_775874115de53f4ac9dfe96ef9fac58f3b2a9a0ae5697e5bff5c94110edaa6ec\", \"document_name\": \"Electric Motor Troubleshooting (Polyphase).pdf\", \"original_end\": 105, \"original_quote\": \"Cause 3b: Motor was single phased as\\nindicated by heat damage to one or two\\nphases of the motor windings.\", \"original_start\": 0, \"page\": 6, \"paragraph_id\": \"P6_B7\", \"quote\": \"Cause 3b: Motor was single phased as indicated by heat damage to one or two phases of the motor windings.\", \"section\": \"Motor will not start; hums and heats\", \"section_id\": \"lincoln-hums\", \"source_paragraph_cleaned\": \"Cause 3b: Motor was single phased as indicated by heat damage to one or two phases of the motor windings.\", \"source_paragraph_original\": \"Cause 3b: Motor was single phased as\\nindicated by heat damage to one or two\\nphases of the motor windings. \\n\"}], \"id\": \"981234e775cd2033cad80d7f\", \"layer\": \"source_claim\", \"object\": \"source_3cc2a0b591dddf9cd567c7be\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P6_B7\", \"quote\": \"Cause 3b: Motor was single phased as indicated by heat damage to one or two phases of the motor windings.\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"failure_mode\", \"text\": \"Motor will not start (Just hums and heats up.)\"}, \"operating_conditions\": null, \"qualifier\": \"asserted\", \"relation\": \"CAUSES\", \"review_note\": \"\", \"subject\": {\"kind\": \"cause\", \"text\": \"Motor was single phased\"}}, \"qualifier\": \"asserted\", \"relation\": \"CAUSES\", \"review\": {\"candidate_hash\": \"5acefd428e79d75a36ddde7e241b6f5cd972286437eeb2637b30129b6e913c60\", \"candidate_id\": \"ATOM_4cb87335d85843e10127ee8a\", \"decision\": \"accepted\", \"note\": \"Source fidelity check only; technical approval pending. Lincoln Trouble 3 / Cause 3b identifies motor single-phasing, evidenced by winding heat damage, for this failure scenario. Numbered association checked.\", \"reviewed_at\": \"2026-09-15T00:14:45.766070+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"12721e542a87b045002c420c\"}, \"run_id\": \"12721e542a87b045002c420c\", \"section\": \"Motor will not start; hums and heats\", \"section_id\": \"lincoln-hums\", \"source_object\": \"3cc2a0b591dddf9cd567c7be\", \"source_subject\": \"f7c6126ce1549ee6d26a7f11\", \"subject\": \"source_f7c6126ce1549ee6d26a7f11\", \"topic\": \"topic_starting\", \"warnings\": [\"endpoint_not_literal_in_quote_check_full_paragraph\"]}" ;
