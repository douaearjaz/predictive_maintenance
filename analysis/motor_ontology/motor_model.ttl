    motor:metadataJSON "{\"applicability\": \"source_context_only\", \"candidate_id\": \"ATOM_ef07cec9dd11e2e983076b5d\", \"document_id\": \"DOC_90dca734e4b5699ff37901e18cdb90275e77ded8b355359130c493820d2fa913\", \"document_name\": \"3GZF500730-85 RevH_EN 06-2022_lowres.pdf\", \"evidence\": [{\"bbox\": [129.922119140625, 522.1167602539062, 467.7701416015625, 531.0137329101562], \"clean_end\": 62, \"clean_start\": 35, \"document_id\": \"DOC_90dca734e4b5699ff37901e18cdb90275e77ded8b355359130c493820d2fa913\", \"document_name\": \"3GZF500730-85 RevH_EN 06-2022_lowres.pdf\", \"original_end\": 62, \"original_quote\": \"Check lines for open phase.\", \"original_start\": 35, \"page\": 25, \"paragraph_id\": \"P25_B16\", \"quote\": \"Check lines for open phase.\", \"section\": \"Motor stalls\", \"section_id\": \"abb-stalls\", \"source_paragraph_cleaned\": \"Motor stalls One phase may be open Check lines for open phase.\", \"source_paragraph_original\": \"Motor stalls\\nOne phase may be open\\nCheck lines for open phase.\\n\"}], \"id\": \"5c471697628d7dabf7ad4ae9\", \"layer\": \"source_claim\", \"object\": \"source_08195682cf2cd011123c22da\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P25_B16\", \"quote\": \"Check lines for open phase.\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"maintenance_action\", \"text\": \"Check lines for open phase.\"}, \"operating_conditions\": null, \"qualifier\": \"asserted\", \"relation\": \"MITIGATED_BY\", \"review_note\": \"\", \"subject\": {\"kind\": \"cause\", \"text\": \"One phase may be open\"}}, \"qualifier\": \"asserted\", \"relation\": \"MITIGATED_BY\", \"review\": {\"candidate_hash\": \"9307d2cd466a6f06441af4dff1515cbd980491e62a3a64bf8f053038e1b0d09d\", \"candidate_id\": \"ATOM_ef07cec9dd11e2e983076b5d\", \"decision\": \"accepted\", \"note\": \"Source fidelity check only; technical approval pending. ABB open-phase row says Check lines for open phase. This is a check for that cause, not all stall causes.\", \"reviewed_at\": \"2026-09-15T00:14:45.675581+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"2cc983acb246bd929a89ac82\"}, \"run_id\": \"2cc983acb246bd929a89ac82\", \"section\": \"Motor stalls\", \"section_id\": \"abb-stalls\", \"source_object\": \"08195682cf2cd011123c22da\", \"source_subject\": \"7d28f2916e29761139c350db\", \"subject\": \"source_7d28f2916e29761139c350db\", \"topic\": \"topic_stalling\", \"warnings\": [\"endpoint_not_literal_in_quote_check_full_paragraph\"]}" ;
