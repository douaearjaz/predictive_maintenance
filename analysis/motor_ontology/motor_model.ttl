    motor:metadataJSON "{\"applicability\": \"source_context_only\", \"candidate_id\": \"ATOM_fa11696f7fe1fc7713b4aab2\", \"document_id\": \"DOC_90dca734e4b5699ff37901e18cdb90275e77ded8b355359130c493820d2fa913\", \"document_name\": \"3GZF500730-85 RevH_EN 06-2022_lowres.pdf\", \"evidence\": [{\"bbox\": [211.87811279296875, 559.7347412109375, 530.62890625, 577.3117065429688], \"clean_end\": 76, \"clean_start\": 12, \"document_id\": \"DOC_90dca734e4b5699ff37901e18cdb90275e77ded8b355359130c493820d2fa913\", \"document_name\": \"3GZF500730-85 RevH_EN 06-2022_lowres.pdf\", \"original_end\": 77, \"original_quote\": \"Ensure the rating plate voltage is maintained. \\nCheck connection.\", \"original_start\": 12, \"page\": 25, \"paragraph_id\": \"P25_B19\", \"quote\": \"Ensure the rating plate voltage is maintained. Check connection.\", \"section\": \"Motor stalls\", \"section_id\": \"abb-stalls\", \"source_paragraph_cleaned\": \"Low voltage Ensure the rating plate voltage is maintained. Check connection.\", \"source_paragraph_original\": \"Low voltage\\nEnsure the rating plate voltage is maintained. \\nCheck connection.\\n\"}], \"id\": \"c5f8a671348ae93ec72c75bf\", \"layer\": \"source_claim\", \"object\": \"source_5c4f262c55dc6fc5fc8133a9\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P25_B19\", \"quote\": \"Ensure the rating plate voltage is maintained. Check connection.\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"maintenance_action\", \"text\": \"Ensure the rating plate voltage is maintained. Check connection.\"}, \"operating_conditions\": null, \"qualifier\": \"asserted\", \"relation\": \"MITIGATED_BY\", \"review_note\": \"\", \"subject\": {\"kind\": \"cause\", \"text\": \"Low voltage\"}}, \"qualifier\": \"asserted\", \"relation\": \"MITIGATED_BY\", \"review\": {\"candidate_hash\": \"b7f87df7068ff984e2365b193493220f28a65a2b8992ec75a2b985277a96bbdb\", \"candidate_id\": \"ATOM_fa11696f7fe1fc7713b4aab2\", \"decision\": \"accepted\", \"note\": \"Source fidelity check only; technical approval pending. ABB Low voltage row pairs with maintaining rating-plate voltage and checking connection. Scope is this cause only.\", \"reviewed_at\": \"2026-09-15T00:14:45.697784+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"2cc983acb246bd929a89ac82\"}, \"run_id\": \"2cc983acb246bd929a89ac82\", \"section\": \"Motor stalls\", \"section_id\": \"abb-stalls\", \"source_object\": \"5c4f262c55dc6fc5fc8133a9\", \"source_subject\": \"7974a85d08a783ca6972e50b\", \"subject\": \"source_7974a85d08a783ca6972e50b\", \"topic\": \"topic_stalling\", \"warnings\": [\"endpoint_not_literal_in_quote_check_full_paragraph\"]}" ;
