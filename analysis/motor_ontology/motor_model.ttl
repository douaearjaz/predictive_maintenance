    motor:metadataJSON "{\"applicability\": \"source_context_only\", \"candidate_id\": \"ATOM_1587c8b5b280930c9f80b154\", \"document_id\": \"DOC_775874115de53f4ac9dfe96ef9fac58f3b2a9a0ae5697e5bff5c94110edaa6ec\", \"document_name\": \"Electric Motor Troubleshooting (Polyphase).pdf\", \"evidence\": [{\"bbox\": [262.0, 523.8578491210938, 544.138916015625, 543.6339111328125], \"clean_end\": 143, \"clean_start\": 0, \"document_id\": \"DOC_775874115de53f4ac9dfe96ef9fac58f3b2a9a0ae5697e5bff5c94110edaa6ec\", \"document_name\": \"Electric Motor Troubleshooting (Polyphase).pdf\", \"original_end\": 143, \"original_quote\": \"Cure 3a: Have a qualified technician check for the proper voltage in\\nall three phases. If a single phase condition exists, correct the problem.\", \"original_start\": 0, \"page\": 6, \"paragraph_id\": \"P6_B9\", \"quote\": \"Cure 3a: Have a qualified technician check for the proper voltage in all three phases. If a single phase condition exists, correct the problem.\", \"section\": \"Motor will not start; hums and heats\", \"section_id\": \"lincoln-hums\", \"source_paragraph_cleaned\": \"Cure 3a: Have a qualified technician check for the proper voltage in all three phases. If a single phase condition exists, correct the problem.\", \"source_paragraph_original\": \"Cure 3a: Have a qualified technician check for the proper voltage in\\nall three phases. If a single phase condition exists, correct the problem.\\n\"}], \"id\": \"f89faaac7787fcdbece443e2\", \"layer\": \"source_claim\", \"object\": \"source_1e6e88c91d8924428a342cc0\", \"operating_conditions\": null, \"original_record\": {\"evidence\": [{\"paragraph_id\": \"P6_B9\", \"quote\": \"Cure 3a: Have a qualified technician check for the proper voltage in all three phases. If a single phase condition exists, correct the problem.\"}], \"needs_context_review\": false, \"object\": {\"kind\": \"maintenance_action\", \"text\": \"qualified technician check for the proper voltage in all three phases\"}, \"operating_conditions\": null, \"qualifier\": \"asserted\", \"relation\": \"MITIGATED_BY\", \"review_note\": \"\", \"subject\": {\"kind\": \"cause\", \"text\": \"Input circuit single phased\"}}, \"qualifier\": \"asserted\", \"relation\": \"MITIGATED_BY\", \"review\": {\"candidate_hash\": \"419393ef826187a5706335a7e44ade33a24b629c382c810c3efd31003c6643ed\", \"candidate_id\": \"ATOM_1587c8b5b280930c9f80b154\", \"decision\": \"accepted\", \"note\": \"Source fidelity check only; technical approval pending. Lincoln Cure 3a explicitly requires a qualified technician to check all three phase voltages. Paired to Cause 3a only; qualification retained in action text. Read full source procedure.\", \"reviewed_at\": \"2026-09-15T00:14:45.761328+00:00\", \"reviewer\": \"Codex\", \"reviewer_kind\": \"assistant\", \"run_id\": \"12721e542a87b045002c420c\"}, \"run_id\": \"12721e542a87b045002c420c\", \"section\": \"Motor will not start; hums and heats\", \"section_id\": \"lincoln-hums\", \"source_object\": \"1e6e88c91d8924428a342cc0\", \"source_subject\": \"bf3e979efbc4ecaaf9dc9663\", \"subject\": \"source_bf3e979efbc4ecaaf9dc9663\", \"topic\": \"topic_starting\", \"warnings\": [\"endpoint_not_literal_in_quote_check_full_paragraph\"]}" ;
